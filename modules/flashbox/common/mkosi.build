#!/bin/bash
set -euxo pipefail

source scripts/make_git_package.sh
source scripts/build_rust_package.sh

# Compile searchersh
mkdir -p "$DESTDIR/usr/bin"
mkosi-chroot gcc -o "$DESTDIR/usr/bin/searchersh" "$SRCDIR/modules/flashbox/common/searchersh.c"
chmod 755 "$DESTDIR/usr/bin/searchersh"

# Compile cryptsetup
make_git_package \
    "cryptsetup" \
    "9cfdd6ba068b375a2b6cda429b3f92388448dd67" \
    "https://gitlab.com/cryptsetup/cryptsetup" \
    './autogen.sh && ./configure --with-crypto_backend=kernel --disable-veritysetup --disable-integritysetup --disable-asciidoc && make -j$(nproc)' \
    ".libs/cryptsetup:/usr/sbin/cryptsetup" \
    ".libs/libcryptsetup.so.12.11.0:/usr/lib/x86_64-linux-gnu/libcryptsetup.so.12"

# Build delay-pipe
build_rust_package \
    "delay-pipe" \
    "v0.0.2" \
    "https://github.com/flashbots/delay-pipe"

# Build tdx-init (using fork with JSON config support)
make_git_package \
    "tdx-init" \
    "19267173bf3286218cdc08d4cc43d0f0ae95d47d" \
    "https://github.com/SeismicSystems/tdx-init" \
    'cd tdx-init-rs && cargo build --release --target-dir ./build' \
    "tdx-init-rs/build/release/tdx-init:/usr/bin/tdx-init"

# Build ssh-pubkey-server
make_git_package \
    "ssh-pubkey-server" \
    "7d1bb0f39f2a183c9804c84f7080ec5d58ae8ec9" \
    "https://github.com/flashbots/ssh-pubkey-server" \
    'go build -trimpath -ldflags "-s -w -buildid= -X github.com/flashbots/go-template/common.Version=v1.0.0" -o ./build/ssh-pubkey-server cmd/httpserver/main.go' \
    "build/ssh-pubkey-server:/usr/bin/ssh-pubkey-server"

make_git_package \
    "cvm-reverse-proxy" \
    "f3a8b3c3e0caa642e1ca62e525e49a8e00057d2b" \
    "https://github.com/flashbots/cvm-reverse-proxy" \
    "make build-proxy-server" \
    "build/proxy-server:/usr/bin/cvm-reverse-proxy"

# Build input-only-proxy
build_rust_package \
    "input-only-proxy" \
    "v0.0.2" \
    "https://github.com/flashbots/input-only-proxy"
