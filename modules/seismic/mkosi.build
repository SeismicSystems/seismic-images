#!/bin/bash
set -euxo pipefail

source scripts/make_git_package.sh

# Source pins live in modules/seismic/sources.yaml so they're a structured,
# machine-editable document (Renovate/Dependabot-friendly) rather than inline shell vars.
SOURCES_YAML="$SRCDIR/modules/seismic/sources.yaml"

TDX_INIT_COMMIT=$(mkosi-chroot yq -r '.tdx_init.git_reference' < "$SOURCES_YAML")
ENCLAVE_COMMIT=$(mkosi-chroot yq -r '.enclave.git_reference' < "$SOURCES_YAML")
RETH_COMMIT=$(mkosi-chroot yq -r '.seismic_reth.git_reference' < "$SOURCES_YAML")
SUMMIT_COMMIT=$(mkosi-chroot yq -r '.summit.git_reference' < "$SOURCES_YAML")

# We manage our own rust toolchain instead of using the one provided by the Debian Snapshot.
# This decouples us from Debian's release cycle and installs deterministically the version
# we need. Note that we use a single version for all repos, instead of relying on the
# per-repo rust-toolchain.toml. This is for simplicity, but also because not all
# repos have a toolchain file anyways.
export CARGO_HOME="/cargo"
export RUSTUP_HOME="/rustup"
export PATH="$CARGO_HOME/bin:$PATH"
RUST_VERSION="1.91.1"
mkosi-chroot rustup toolchain install "$RUST_VERSION" --profile minimal
mkosi-chroot rustup default "$RUST_VERSION"

# Declare the build-env state whose changes should invalidate
# make_git_package.sh's per-package binary cache. Each `|`-separated
# segment is "label-value"; if any value drifts, the env_hash changes
# and cached binaries get rebuilt fresh.
#
# What's tracked here:
#   - rust-${RUST_VERSION}: rustc/cargo version we install via rustup.
#     Bumping it should rebuild everything against the new toolchain.
#   - cargo-home / rustup-home: where cargo's dep cache and rustup's
#     toolchain state live. If these paths change, the build env's
#     filesystem layout changed; cached binaries may have been linked
#     against state at a different path.
export MAKE_GIT_PACKAGE_CACHE_KEY_EXTRA="rust-${RUST_VERSION}|cargo-home-${CARGO_HOME}|rustup-home-${RUSTUP_HOME}"

# Build tdx-init (using Seismic fork with JSON config support)
TDX_INIT_BUILD_CMD="
    cargo build --release --target-dir ./build
"
make_git_package \
    "tdx-init" \
    "$TDX_INIT_COMMIT" \
    "https://github.com/SeismicSystems/tdx-init" \
    "$TDX_INIT_BUILD_CMD" \
    "build/release/tdx-init:/usr/bin/tdx-init"

# Build seismic-reth
RETH_BUILD_CMD="
    git checkout $RETH_COMMIT
    export RUSTFLAGS='-C target-cpu=generic -C link-arg=-Wl,--build-id=none -C symbol-mangling-version=v0'
    export CARGO_PROFILE_RELEASE_LTO='thin'
    export CARGO_PROFILE_RELEASE_CODEGEN_UNITS='1'
    export CARGO_PROFILE_RELEASE_PANIC='abort'
    export CARGO_PROFILE_RELEASE_STRIP='none'
    export CARGO_PROFILE_RELEASE_OPT_LEVEL='3'

    cargo fetch
    cargo build --release --frozen --bin seismic-reth
"
make_git_package \
    "seismic-reth" \
    "$RETH_COMMIT" \
    "https://github.com/SeismicSystems/seismic-reth" \
    "$RETH_BUILD_CMD" \
    "target/release/seismic-reth:/usr/bin/seismic-reth" \
    "crates/seismic/chainspec/res/genesis/dev.json:/usr/share/seismic-reth/genesis.json"

# Build enclave (seismic-enclave-server)
ENCLAVE_BUILD_CMD="
    git checkout $ENCLAVE_COMMIT
    export RUSTFLAGS='-C target-cpu=generic -C link-arg=-Wl,--build-id=none -C symbol-mangling-version=v0'
    export CARGO_PROFILE_RELEASE_LTO='off'
    export CARGO_PROFILE_RELEASE_CODEGEN_UNITS='1'
    export CARGO_PROFILE_RELEASE_PANIC='abort'
    export CARGO_PROFILE_RELEASE_STRIP='none'
    export CARGO_PROFILE_RELEASE_OPT_LEVEL='z'

    cargo fetch
    cargo build --release --frozen --bin seismic-enclave-server
"
make_git_package \
    "enclave" \
    "$ENCLAVE_COMMIT" \
    "https://github.com/SeismicSystems/enclave" \
    "$ENCLAVE_BUILD_CMD" \
    "target/release/seismic-enclave-server:/usr/bin/seismic-enclave-server"

# Build summit (summit)
SUMMIT_BUILD_CMD="
    git checkout $SUMMIT_COMMIT
    export RUSTFLAGS='-C target-cpu=generic -C link-arg=-Wl,--build-id=none -C symbol-mangling-version=v0'
    export CARGO_PROFILE_RELEASE_LTO='thin'
    export CARGO_PROFILE_RELEASE_CODEGEN_UNITS='1'
    export CARGO_PROFILE_RELEASE_PANIC='abort'
    export CARGO_PROFILE_RELEASE_STRIP='none'
    export CARGO_PROFILE_RELEASE_OPT_LEVEL='3'

    cargo fetch
    cargo build --release --frozen --bin summit --features prom
"
make_git_package \
    "summit" \
    "$SUMMIT_COMMIT" \
    "https://github.com/SeismicSystems/summit" \
    "$SUMMIT_BUILD_CMD" \
    "target/release/summit:/usr/bin/summit"
