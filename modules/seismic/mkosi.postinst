#!/bin/bash
set -euxo pipefail

# Create the system users/groups our services run as (User=, Group= in unit files).
# They have to exist in the image's /etc/passwd and /etc/group at boot;
# hence build-time creation here via mkosi-chroot, not at first boot. Each user is referenced
# by name in the corresponding service unit; deleting any of these breaks startup.
# TODO(samlaf): consider switching to systemd-sysusers for declarative user/group creation.
mkosi-chroot groupadd -r engine-api    # reth ↔ summit engine-API IPC socket at /run/reth-engine/api.ipc
mkosi-chroot groupadd -r custodian-ipc # local clients authorized to reach the key-custodian socket
mkosi-chroot groupadd -r conf          # readers of the config tdx-init writes to /run/seismic/conf
mkosi-chroot groupadd -r tpm           # /dev/tpm* access for quote minting (60-tpm-permissions.rules)

# tdx-init owns /run/seismic/conf, whose setgid bit gives every file it writes
# group conf, so it needs no conf membership of its own.
mkosi-chroot useradd -r -s /bin/false tdx-init
# The custodian doesn't need the conf group because its one config
# input (custodian.env) is loaded by systemd as root via EnvironmentFile=
mkosi-chroot useradd -r -s /bin/false custodian
# Only attestation is in tpm: it mints every quote on the node, the founding
# harvest's included. Any process that can quote arbitrary report_data can
# have a peer wrap root_key to a key of its own, so the set stays at one.
mkosi-chroot useradd -r -s /bin/false -G conf,custodian-ipc,tpm attestation
# reth fetches its keys from the custodian socket (custodian.service grants
# reth:tx-io,rng).
mkosi-chroot useradd -r -s /bin/false -G conf,engine-api,custodian-ipc reth
mkosi-chroot useradd -r -s /bin/false -G conf,engine-api summit

# Make scripts executable
chmod +x "$BUILDROOT/usr/bin/nginx-ssl-setup"
chmod +x "$BUILDROOT/usr/bin/persistent-luks-setup"
chmod +x "$BUILDROOT/usr/bin/summit-persist"

# Enable services
mkdir -p "$BUILDROOT/etc/systemd/system/minimal.target.wants"
for service in \
    persistent-luks-setup.service \
    tdx-init.service \
    nginx-ssl-setup.service \
    reth.service \
    custodian.service \
    attestation.service \
    summit.target
do
    mkosi-chroot systemctl enable "$service"
    ln -sf "/etc/systemd/system/$service" "$BUILDROOT/etc/systemd/system/minimal.target.wants/"
done

# Note: certbot-renew.timer is enabled by nginx-ssl-setup after initial certbot run
