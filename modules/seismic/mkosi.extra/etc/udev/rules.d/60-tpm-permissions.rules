# The enclave is the only in-VM TPM consumer, hence we use Group=enclave
# instead of the Debian-conventional `tss` group.
#
# Only the resource-manager interface (/dev/tpmrm[0-9]*) is needed.
# Raw /dev/tpm[0-9]* stays at kernel-default root:root 0600.
KERNEL=="tpmrm[0-9]*", GROUP="enclave", MODE="0660"
