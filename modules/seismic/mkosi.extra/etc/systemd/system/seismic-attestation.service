[Unit]
Description=Seismic Attestation Service
# Starts at boot, before any configuration exists, so the founding harvest on
# :7879 can serve summit's public keys and the custodian's candidate
# tx_io_pk@0, and a quote over them, before the config POST. After
# seismic-summit-keygen, which writes the public-keys file the harvest serves;
# network-online is for the IMDS round-trip in the quote path.
After=network-online.target seismic-summit-keygen.service
# The :7878 side reads its peers once tdx-init's done marker appears, so
# tdx-init is not an ordering dependency; Wants= only pulls it into the boot.
Wants=network-online.target seismic-tdx-init.service
# Restarts with the custodian, so the root-key bootstrap runs again whenever
# the custodian loses root_key; see seismic-custodian.service for what a restart
# reaches. After= orders that bootstrap after the restarted custodian's
# socket; the socket client retries regardless.
Requires=seismic-custodian.service
After=seismic-custodian.service

[Service]
Type=simple
User=attestation

Environment=RUST_BACKTRACE=full
Environment=RUST_LOG=info

# Holds no key material: every key operation goes through the custodian's
# Unix socket (the attestation user is in the custodian-ipc group; the custodian's
# --allow grants scope what it may call). The :7878 listener binds only once
# the custodian holds the root key, so the open port doubles as the
# readiness signal deploy tooling watches.
#
# :7879 is plain HTTP and reachable pre-admission. /v1/quote answers 410 once
# the network manifest exists, but the conf dir is tmpfs, so the window
# reopens every boot. It must stay operator-only, permanently, and that can
# only be enforced outside the guest, by the cloud firewall: it has to hold
# before the config POST, and the operator's range is not in the image.
ExecStart=/usr/bin/seismic-attestation-service \
    --peer-listen 0.0.0.0:7878 \
    --operator-listen 0.0.0.0:7879

Restart=always
RestartSec=60
StandardOutput=journal
StandardError=journal

####### SANDBOX #######
# What code running inside the attestation service could still reach, on top of
# the shared baseline in seismic-.service.d/. It holds no key material, writes
# nothing, and needs the network, the custodian's socket and the TPM.

# Network
# Its own slice, outside system.slice's port reservation (see system.slice.d/),
# so it can bind its own ports. Only TCP is denied wholesale: its DNS resolver
# (hickory, via reqwest) binds a random UDP source port for every query, so UDP
# stays open except reth's devp2p port.
Slice=seismic-attestation.slice
SocketBindAllow=tcp:7878
SocketBindAllow=tcp:7879
SocketBindDeny=tcp
SocketBindDeny=udp:30303
# IP sockets, beside the baseline's Unix ones.
RestrictAddressFamilies=AF_INET AF_INET6

# Devices
# Its only device is the TPM. PrivateDevices= would hide /dev/tpm0, so a
# closed device policy takes its place.
DevicePolicy=closed
DeviceAllow=/dev/tpm0 rw
DeviceAllow=/dev/tpmrm0 rw

# Privileges
# No Linux capabilities, ever, even as UID 0.
CapabilityBoundingSet=
####### END SANDBOX #######

[Install]
WantedBy=minimal.target
