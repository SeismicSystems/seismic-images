[Unit]
Description=Provision and unlock the persistent LUKS volume, mount /persistent
# The LUKS keyfile the custodian writes is this unit's only synchronization
# point, and it also implies tdx-init has finished: the custodian writes it
# once it holds root_key, which the attestation service fetches or confirms
# only after tdx-init's done marker, written after every other config file. So
# every unit ordered after this one finds /run/seismic/conf complete.
# After=seismic-tdx-init only keeps this unit queued, rather than polling, until the
# config POST.
#
# Wants= rather than Requires= on all three: Requires= would restart this unit
# whenever one of them restarts (see seismic-custodian.service), and would
# cancel its queued start for good if tdx-init failed once, even when
# tdx-init's Restart= then recovers.
After=seismic-tdx-init.service
Wants=seismic-tdx-init.service seismic-custodian.service seismic-attestation.service

[Service]
Type=oneshot
RemainAfterExit=yes

ExecStart=/usr/bin/seismic-persistent-luks-setup
# Materialize per-service /persistent/<svc> ownership and mode now that /persistent is mounted.
ExecStartPost=/usr/bin/systemd-tmpfiles --create /etc/seismic/tmpfiles-persistent.conf

# Backstop for unforeseen failures only.
# A failure here — even one a restart later recovers — cancels the queued start
# jobs of every Requires= dependent (seismic-caddy, seismic-reth,
# seismic-summit-persist, seismic-summit), and systemd never re-enqueues them. If that stranding ever happens anyway,
# `systemctl start seismic-summit.target` pulls the whole chain back up.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=minimal.target
