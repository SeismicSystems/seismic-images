[Unit]
Description=Certbot SSL Certificate Renewal
After=network-online.target persistent-luks-setup.service
Requires=persistent-luks-setup.service
# The timer is enabled in every image, but only a node whose nginx-ssl-setup
# obtained a certificate has anything to renew.
ConditionPathExists=/persistent/nginx/.certbot-done

[Service]
Type=oneshot
ExecStart=/usr/bin/certbot renew --quiet --nginx --config-dir /persistent/nginx/certbot --work-dir /persistent/nginx/certbot/work --logs-dir /persistent/nginx/certbot/logs

# TODO: create lockfile when snapshots are running; don't run this until it's deleted
