[Unit]
Description=Seismic Key Custodian
# Starts at boot, before any configuration exists, and mints a candidate
# root_key in RAM, writing its public tx_io_pk@0 to
# /run/seismic/custodian/candidate-tx-io-pk for the founding harvest to
# quote. The manifest's pin decides the candidate's fate: the custodian reads
# it from /run/seismic/conf (via its `conf` group) when the attestation
# service first asks for root_key, which it does only after the config POST.
# So tdx-init is not an ordering dependency.

[Service]
Type=simple
User=custodian

Environment=RUST_BACKTRACE=full
Environment=RUST_LOG=info
# The custodian owns root_key in process memory and serves key operations on
# /run/seismic/custodian/custodian.sock only — no network listener. Callers
# authenticate by UID (SO_PEERCRED); the socket dir's custodian-ipc group
# gates who can connect at all, and the grants below gate what a connected
# UID may call. The grants live here, next to the user definitions in
# mkosi.postinst, so names and grants can't drift apart and the ACL is part
# of the measured image.
#
# attestation's grants cover exactly the root-key bootstrap flow, retiring the
# founding policy once the chain passes block 0, and public-only tx-io evidence
# minting (tx-io-public) — never a purpose that exposes tx_io_sk to the
# network-facing process.
# reth fetches its own keys from the socket (tx-io,rng). 
# The snapshot purpose stays ungranted until snapshot-svc exists.
ExecStart=/usr/bin/seismic-custodian-service \
    --allow attestation:tx-io-public,create-root-key-bootstrap-attempt,wrap-root-key,retire-founding-policy,install-root-key-from-verified-bootstrap-response \
    --allow reth:tx-io,rng

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=minimal.target
