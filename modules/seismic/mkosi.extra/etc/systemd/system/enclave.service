[Unit]
Description=Seismic Enclave Server
After=network.target persistent-luks-setup.service tdx-init.service nginx-ssl-setup.service
Requires=persistent-luks-setup.service tdx-init.service nginx-ssl-setup.service

[Service]
Type=simple
User=enclave

# /run/seismic/enclave/ — drop-zone for the storage_key + header_mac_key
# the enclave-server writes at startup for setup-persistent-luks to read.
# tmpfs, recreated on every restart with enclave:enclave 0700.
RuntimeDirectory=seismic/enclave
RuntimeDirectoryMode=0700

Environment=RUST_BACKTRACE=full
Environment=RUST_LOG=info
# The dir is created by /etc/tmpfiles.d/seismic-runtime.conf, and
# the file is written by tdx-init on every boot (after operator POSTs the config).
# systemd refuses to start the unit if this file is missing; its existence is
# an invariant of the boot chain (tdx-init.service is a Requires= above and produces
# this file before exiting successfully).
EnvironmentFile=/run/seismic/conf/enclave.env

ExecStart=/usr/bin/seismic-enclave-server --ip 0.0.0.0 --port 7878

Restart=always
RestartSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=minimal.target
