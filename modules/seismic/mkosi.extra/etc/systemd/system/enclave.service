[Unit]
Description=Seismic Enclave Server
After=network.target persistent-luks-setup.service nginx-ssl-setup.service tpm-permissions.service
Requires=persistent-luks-setup.service nginx-ssl-setup.service tpm-permissions.service

[Service]
Type=simple
User=enclave
Group=eth
Environment=RUST_BACKTRACE=full
Environment=RUST_LOG=info

# The +/… prefix forces these to run as root regardless of the User= setting.
# The enclave user needs /persistent/enclave to exist and be writable; only
# root can chown on first boot when the dir is freshly created.
ExecStartPre=+/bin/mkdir -p /persistent/enclave
ExecStartPre=+/bin/chown -R enclave:eth /persistent/enclave
ExecStartPre=+/bin/chmod 775 /persistent /persistent/enclave

ExecStart=/usr/bin/seismic-enclave-server --ip 0.0.0.0 --port 7878

Restart=always
RestartSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=minimal.target
