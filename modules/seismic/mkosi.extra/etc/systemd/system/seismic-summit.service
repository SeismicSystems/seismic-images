[Unit]
Description=Summit Consensus Server
After=network.target seismic-persistent-luks-setup.service seismic-reth.service seismic-summit-persist.service
Requires=seismic-persistent-luks-setup.service seismic-reth.service seismic-summit-persist.service
PartOf=seismic-summit.target

[Service]
Type=simple
User=summit
UMask=0002
# TODO: RUST_LOG currently has no effect on summit. Its telemetry setup
# calls tracing_subscriber::EnvFilter::new(level.to_string()) with the
# --log-level CLI value, instead of EnvFilter::from_default_env() which
# would pick up RUST_LOG. See node/src/telemetry.rs in SeismicSystems/summit.
# Until summit is fixed, --log-level on the ExecStart line below is the
# only control knob; this env var is here for parity with reth/enclave
# and will start working once summit's EnvFilter construction is updated.
Environment=RUST_LOG=info

# seismic-summit-persist.service is the only writer of the keystore, and summit
# only reads it. It must never gain a keygen step of its own, even as a
# fallback: that would mint fresh keys the manifest never pinned, turning a
# loud startup failure into a launch-check mismatch. The public-keys file the
# attestation service serves is read-only here for the same reason. The
# sandbox baseline's ProtectSystem=strict leaves both read-only, and
# ReadWritePaths= opens only the database.
InaccessiblePaths=/run/seismic/summit/keys

# Required (no `-`): seismic-persistent-luks-setup finishing implies tdx-init
# wrote summit.env (see that unit), so a missing file is a real boot failure,
# not something to tolerate.
EnvironmentFile=/run/seismic/conf/summit.env

# --rpc-ip/--prom-ip 0.0.0.0: public, for the network's front outside the node
# to reach; no proxy in the image terminates TLS. Which sources reach each port
# is the cloud firewall's to decide. The admin RPC on :3031, which signs with
# the validator key, has no address flag: summit binds it on loopback only.
# --genesis-path: written verbatim by tdx-init on every boot from the
# operator POST's summit_genesis_base64 (readable via summit's `conf`
# supplementary group). The network manifest pins its config_digest, so a
# divergent genesis cannot handshake with the cohort.
# --ip ${SUMMIT_ADVERTISED_ADDR}: the consensus address this node signs and
# gossips, which is what the rest of the cohort dials it on. tdx-init composes
# it from the operator's POSTed external_ip, the same address reth advertises via
# --nat extip, so the two planes agree on where this machine is. Without it
# summit takes the address from its own genesis entry, which only a founding node
# has, and a joiner would fall back to asking public IP-echo services:
# https://github.com/SeismicSystems/enclave/blob/seismic/bin/tdx-init/src/peers.rs
# Quoted expansion (${...}, not $...) so the address stays one argument, and
# because it is always populated there is no empty-var case to drop. Its port
# must stay equal to --port below: the address is what peers dial, --port is what
# the node listens on.
ExecStart=/usr/bin/summit run \
    --engine-ipc-path /run/reth-engine/api.ipc \
    --genesis-path /run/seismic/conf/summit-genesis.toml \
    --store-path /persistent/summit/db \
    --key-store-path /persistent/summit/keys \
    --ip ${SUMMIT_ADVERTISED_ADDR} \
    --port 18551 \
    --rpc-ip 0.0.0.0 \
    --rpc-port 3030 \
    --prom-ip 0.0.0.0 \
    --prom-port 9002 \
    --db-prefix quarts \
    --log-level info

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

####### SANDBOX #######
# What code running inside summit could still reach, on top of the shared
# baseline in seismic-.service.d/. It holds the consensus signing keys, and
# needs its ports, reth's Engine API socket and its database.

# Network
# Its own slice, outside system.slice's port reservation (see system.slice.d/),
# so it can bind its own ports. SocketBindDeny=any keeps it off every other
# port, the other node services' included. tcp:3031 is the admin RPC, which
# summit binds on loopback by default, and which stops the REST server on :3030
# too when its bind fails.
Slice=seismic-summit.slice
SocketBindAllow=tcp:3030
SocketBindAllow=tcp:3031
SocketBindAllow=tcp:9002
SocketBindAllow=tcp:18551
SocketBindDeny=any
# IP sockets, beside the baseline's Unix ones.
RestrictAddressFamilies=AF_INET AF_INET6

# Filesystem
# Its database.
ReadWritePaths=/persistent/summit/db

# Devices
# A minimal /dev of pseudo-devices: no TPM, no disks, no /dev/mem.
PrivateDevices=yes

# Privileges
# No Linux capabilities, ever, even as UID 0.
CapabilityBoundingSet=
####### END SANDBOX #######
