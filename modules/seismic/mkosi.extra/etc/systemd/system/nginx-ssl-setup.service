[Unit]
Description=Setup Nginx with SSL via Certbot
After=network-online.target persistent-luks-setup.service tdx-init.service
Wants=network-online.target
Requires=persistent-luks-setup.service tdx-init.service

[Service]
Type=oneshot
ExecStart=/usr/bin/setup-nginx-ssl
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
