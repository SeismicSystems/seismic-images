[Unit]
Description=Provision and unlock the persistent LUKS volume, mount /persistent
# The custodian writes the LUKS keyfile the setup script polls for; on a
# joining node that happens only once the attestation service completes the
# root-key bootstrap, so both are required. Either way the custodian holds
# root_key only once the manifest exists, so tdx-init has run; requiring it
# here makes that explicit for everything ordered after this unit.
After=tdx-init.service custodian.service attestation.service
Requires=tdx-init.service custodian.service attestation.service

[Service]
Type=oneshot
RemainAfterExit=yes

ExecStart=/usr/bin/persistent-luks-setup
# Materialize per-service /persistent/<svc> ownership and mode now that /persistent is mounted.
ExecStartPost=/usr/bin/systemd-tmpfiles --create /etc/seismic/tmpfiles-persistent.conf

# Backstop for unforeseen failures only. 
# A failure here — even one a restart later recovers — cancels the queued start
# jobs of every Requires= dependent (nginx-ssl-setup/reth/summit-persist/summit),
# and systemd never re-enqueues them. If that stranding ever happens anyway,
# `systemctl start summit.target` pulls the whole chain back up.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=minimal.target
