[Unit]
Description=Provision and unlock the persistent LUKS volume, mount /persistent
# The custodian writes the LUKS keyfile the setup script polls for; on a
# joining node that happens only once the attestation service completes the
# root-key bootstrap, so both are required.
After=custodian.service attestation.service
Requires=custodian.service attestation.service

[Service]
Type=oneshot
RemainAfterExit=yes

ExecStart=/usr/bin/setup-persistent-luks
# Materialize per-service /persistent/<svc> ownership and mode now that /persistent is mounted.
ExecStartPost=/usr/bin/systemd-tmpfiles --create /etc/seismic/tmpfiles-persistent.conf

# Backstop for unforeseen failures only. 
# A failure here — even one a restart later recovers — cancels the queued start
# jobs of every Requires= dependent (nginx-ssl-setup/reth/summit), and systemd
# never re-enqueues them. If that stranding ever happens anyway,
# `systemctl start summit.service` pulls the whole chain back up.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=minimal.target
