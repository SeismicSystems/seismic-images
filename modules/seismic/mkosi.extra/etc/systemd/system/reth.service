[Unit]
Description=Seismic Reth Node
After=network.target persistent-luks-setup.service nginx-ssl-setup.service attestation.service
Requires=persistent-luks-setup.service nginx-ssl-setup.service attestation.service

[Service]
Type=simple
User=reth
# Group= override is load-bearing here: the RuntimeDirectory= below creates
# /run/reth-engine/ with the unit's primary group. Without engine-api here,
# the dir would be reth:reth and summit couldn't open the IPC socket inside.
Group=engine-api
UMask=0002
Environment=RUST_LOG=info

# Creates /run/reth-engine at service start, where the API engine ipc socket lives.
RuntimeDirectory=reth-engine
RuntimeDirectoryMode=0750
# Keeps the dir across reth restarts so summit doesn't see it disappear briefly.
RuntimeDirectoryPreserve=restart

# /persistent/reth is created by /etc/seismic/tmpfiles-persistent.conf via
# persistent-luks-setup's ExecStartPost.
#
# tdx-init writes /run/seismic/conf/reth-genesis.json from the operator's
# config POST, re-delivered on every boot (/run is tmpfs). The Requires=
# chain above (attestation.service -> tdx-init.service) guarantees
# it exists before this unit starts.
#
# RPC (8545) + WS (8546) bind to loopback: nginx terminates TLS on 443 and
# reverse-proxies /rpc + /ws to them, so they must not be reachable off-box.
# --http.api all would otherwise expose admin/debug/txpool in the clear; make
# sure the NSG doesn't open these ports publicly either (defense in depth).
ExecStart=/usr/bin/seismic-reth node \
    --http.corsdomain "*" \
    --ws.origins "*" \
    --enclave.endpoint-addr 0.0.0.0 \
    --enclave.endpoint-port 7878 \
    --chain /run/seismic/conf/reth-genesis.json \
    --datadir /persistent/reth \
    --http \
    --http.addr 127.0.0.1 \
    --http.port 8545 \
    --http.api all \
    --ws \
    --ws.addr 127.0.0.1 \
    --ws.port 8546 \
    --ws.api all \
    --auth-ipc \
    --auth-ipc.path /run/reth-engine/api.ipc \
    --log.stdout.format json \
    --log.file.max-files 0 \
    --metrics 127.0.0.1:9001

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=minimal.target
