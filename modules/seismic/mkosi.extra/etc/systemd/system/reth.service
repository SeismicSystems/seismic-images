[Unit]
Description=Seismic Reth Node
After=network.target persistent-luks-setup.service nginx-ssl-setup.service enclave.service
Requires=persistent-luks-setup.service nginx-ssl-setup.service enclave.service

[Service]
Type=simple
User=reth
Group=eth
UMask=0002
Environment=RUST_LOG=info

ExecStartPre=+/bin/mkdir -p /persistent/reth
ExecStartPre=+/bin/mkdir -p /var/volatile
ExecStartPre=+/bin/chown reth:eth /var/volatile
ExecStartPre=+/bin/chown -R reth:eth /persistent/reth
ExecStartPre=+/bin/chmod -R g+rwX /persistent/reth
ExecStartPre=+/bin/chmod g+s /persistent/reth

ExecStart=/usr/bin/seismic-reth node \
    --http.corsdomain "*" \
    --ws.origins "*" \
    --enclave.endpoint-addr 0.0.0.0 \
    --enclave.endpoint-port 7878 \
    --chain /usr/share/seismic-reth/genesis.json \
    --datadir /persistent/reth \
    --http \
    --http.addr 0.0.0.0 \
    --http.port 8545 \
    --http.api all \
    --ws \
    --ws.addr 0.0.0.0 \
    --ws.port 8546 \
    --ws.api all \
    --auth-ipc \
    --auth-ipc.path /var/volatile/reth_engine_api.ipc \
    --log.stdout.format json \
    --log.file.max-files 0 \
    --metrics 127.0.0.1:9001

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=minimal.target
