[Unit]
Description=Seismic Reth Node
After=network.target persistent-luks-setup.service nginx-ssl-setup.service enclave.service
Requires=persistent-luks-setup.service nginx-ssl-setup.service enclave.service

[Service]
Type=simple
User=reth
# Group= override is load-bearing here: the RuntimeDirectory= below creates
# /run/reth-engine/ with the unit's primary group. Without engine-api here,
# the dir would be reth:reth and summit couldn't open the IPC socket inside.
Group=engine-api
UMask=0002
Environment=RUST_LOG=info

# Creates /run/reth-engine at service start, where the API engine ipc socket lives.
RuntimeDirectory=reth-engine
RuntimeDirectoryMode=0750
# Keeps the dir across reth restarts so summit doesn't see it disappear briefly.
RuntimeDirectoryPreserve=restart

# /persistent/reth is created by /etc/seismic/tmpfiles-persistent.conf via
# persistent-luks-setup's ExecStartPost.
ExecStart=/usr/bin/seismic-reth node \
    --http.corsdomain "*" \
    --ws.origins "*" \
    --enclave.endpoint-addr 0.0.0.0 \
    --enclave.endpoint-port 7878 \
    --chain /usr/share/seismic-reth/genesis.json \
    --datadir /persistent/reth \
    --http \
    --http.addr 0.0.0.0 \
    --http.port 8545 \
    --http.api all \
    --ws \
    --ws.addr 0.0.0.0 \
    --ws.port 8546 \
    --ws.api all \
    --auth-ipc \
    --auth-ipc.path /run/reth-engine/api.ipc \
    --log.stdout.format json \
    --log.file.max-files 0 \
    --metrics 127.0.0.1:9001

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=minimal.target
