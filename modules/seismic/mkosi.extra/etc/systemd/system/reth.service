[Unit]
Description=Seismic Reth Node
After=network.target persistent-luks-setup.service nginx-ssl-setup.service attestation.service
Requires=persistent-luks-setup.service nginx-ssl-setup.service attestation.service

[Service]
Type=simple
User=reth
# Group= override is load-bearing here: the RuntimeDirectory= below creates
# /run/reth-engine/ with the unit's primary group. Without engine-api here,
# the dir would be reth:reth and summit couldn't open the IPC socket inside.
Group=engine-api
UMask=0002
Environment=RUST_LOG=info

# Creates /run/reth-engine at service start, where the API engine ipc socket lives.
RuntimeDirectory=reth-engine
RuntimeDirectoryMode=0750
# Keeps the dir across reth restarts so summit doesn't see it disappear briefly.
RuntimeDirectoryPreserve=restart

# Argument partition: flags fixed for this image are hardcoded below -- even
# ones pointing at a fixed path whose *contents* tdx-init fills from the
# operator's config POST (--chain reth-genesis.json is a constant path). Flags
# whose very presence or value is conditional on that POST (bootnodes, NAT
# extip) can't be hardcoded, so tdx-init emits them as flag fragments in
# reth-p2p.env, spliced in via $RETH_*_FLAG.

# reth-p2p.env: tdx-init writes RETH_BOOTNODES_FLAG (--bootnodes <csv>; empty
# on the genesis node) and RETH_NAT_FLAG (--nat extip:<ip>; always set --
# external_ip is a required config field) each boot. Required
# (no `-`): the Requires= chain (attestation -> tdx-init) guarantees it exists,
# so a missing file is a real boot failure, not something to tolerate.
EnvironmentFile=/run/seismic/conf/reth-p2p.env

# --chain reth-genesis.json: tdx-init writes it each boot (/run is tmpfs); the
#   Requires= chain (attestation -> tdx-init) guarantees it exists first.
# --datadir /persistent/reth: created by tmpfiles-persistent.conf via
#   persistent-luks-setup's ExecStartPost.
# --http.api/--ws.api eth,net,web3 (not `all`): nginx proxies /rpc+/ws wholesale,
#   so this allowlist is what keeps admin/debug/txpool off the public surface. The
#   seismic namespace and eth_ overrides register regardless;
# --ipcdisable: reth's general IPC-RPC server is on by default at /tmp/reth.ipc
#   and exposes ALL namespaces (admin/debug/txpool); disable it so the allowlist
#   above can't be bypassed over that local socket. --auth-ipc is a separate
#   server (engine API) and stays enabled for summit;
# --http.corsdomain/--ws.origins "*": deliberate — /rpc+/ws are browser-facing;
#   the boundary is the namespace allowlist, not CORS.
# devp2p: discv5-only (discv4+DNS off) on 30303, the only port the NSG opens.
#   --discovery.v5.port 30303 is load-bearing (reth defaults discv5 to 9200). No
#   --p2p-secret-key: reth persists node identity under --datadir.
# $RETH_*_FLAG unquoted so systemd word-splits: empty vars drop out entirely.
ExecStart=/usr/bin/seismic-reth node \
    --http.corsdomain "*" \
    --ws.origins "*" \
    --seismic.custodian.socket /run/seismic/custodian/custodian.sock \
    --chain /run/seismic/conf/reth-genesis.json \
    --datadir /persistent/reth \
    --http \
    --http.addr 127.0.0.1 \
    --http.port 8545 \
    --http.api eth,net,web3 \
    --ws \
    --ws.addr 127.0.0.1 \
    --ws.port 8546 \
    --ws.api eth,net,web3 \
    --ipcdisable \
    --auth-ipc \
    --auth-ipc.path /run/reth-engine/api.ipc \
    --port 30303 \
    --disable-discv4-discovery \
    --disable-dns-discovery \
    --enable-discv5-discovery \
    --discovery.v5.port 30303 \
    --log.stdout.format json \
    --log.file.max-files 0 \
    --metrics 127.0.0.1:9001 \
    $RETH_BOOTNODES_FLAG $RETH_NAT_FLAG

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=minimal.target
