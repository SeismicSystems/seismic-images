[Unit]
Description=Summit Consensus Server
After=network.target persistent-luks-setup.service nginx-ssl-setup.service attestation.service reth.service
Requires=persistent-luks-setup.service nginx-ssl-setup.service attestation.service reth.service

[Service]
Type=simple
User=summit
UMask=0002
# TODO: RUST_LOG currently has no effect on summit. Its telemetry setup
# calls tracing_subscriber::EnvFilter::new(level.to_string()) with the
# --log-level CLI value, instead of EnvFilter::from_default_env() which
# would pick up RUST_LOG. See node/src/telemetry.rs in SeismicSystems/summit.
# Until summit is fixed, --log-level on the ExecStart line below is the
# only control knob; this env var is here for parity with reth/enclave
# and will start working once summit's EnvFilter construction is updated.
Environment=RUST_LOG=info

# /persistent/summit{,/db,/keys} are created by /etc/seismic/tmpfiles-persistent.conf
# via persistent-luks-setup's ExecStartPost. `summit keys generate -n` then generates two
# keys into /persistent/summit/keys if they don't already exist:
#   - node_key.pem      ed25519 — libp2p peer identity (commonware-p2p)
#   - consensus_key.pem BLS12-381 — Simplex BFT validator signing key
# `-n` means "don't overwrite if present," so first boot generates both
# and every subsequent boot is a no-op (these are this validator's
# persistent identity, generated once and kept for life).
ExecStartPre=/usr/bin/summit keys generate -n --key-store-path /persistent/summit/keys

# TODO: add `--rpc-ip 127.0.0.1` once https://github.com/SeismicSystems/summit/pull/434
# is merged. Until then it binds 0.0.0.0 — make sure the NSG doesn't open :3030 publicly.
ExecStart=/usr/bin/summit run \
    --engine-ipc-path /run/reth-engine/api.ipc \
    --genesis-path /persistent/summit/genesis.toml \
    --store-path /persistent/summit/db \
    --key-store-path /persistent/summit/keys \
    --port 18551 \
    --rpc-port 3030 \
    --prom-ip 127.0.0.1 \
    --prom-port 9002 \
    --db-prefix quarts \
    --log-level info

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=minimal.target
