[Unit]
Description=Summit Consensus Server
After=network.target persistent-luks-setup.service nginx-ssl-setup.service attestation.service reth.service summit-key-holder.service
Requires=persistent-luks-setup.service nginx-ssl-setup.service attestation.service reth.service summit-key-holder.service

[Service]
Type=simple
User=summit
UMask=0002
# TODO: RUST_LOG currently has no effect on summit. Its telemetry setup
# calls tracing_subscriber::EnvFilter::new(level.to_string()) with the
# --log-level CLI value, instead of EnvFilter::from_default_env() which
# would pick up RUST_LOG. See node/src/telemetry.rs in SeismicSystems/summit.
# Until summit is fixed, --log-level on the ExecStart line below is the
# only control knob; this env var is here for parity with reth/enclave
# and will start working once summit's EnvFilter construction is updated.
Environment=RUST_LOG=info

# summit-key-holder.service is the sole provisioner of the keystore: it
# generates the keys in RAM at boot (so deploy's founding harvest can pin
# them into the network manifest before this node has any identity) and
# writes them into /persistent/summit/keys on its `persist` op. persist-wait
# blocks on that op — keystore written (first boot) or confirmed decodable
# (reboot; the fresh RAM keys are discarded, and the launch-time continuity
# assertion is what surfaces a pin mismatch) — and exits nonzero on any
# definitive failure, so summit never starts on keys the network manifest
# never pinned. The persistent-luks-setup → summit ordering above is what
# brackets the persist after /persistent is mounted (tmpfiles-persistent.conf
# creates /persistent/summit{,/db,/keys} via its ExecStartPost).
ExecStartPre=/usr/bin/summit-key-holder persist-wait

# TODO: add `--rpc-ip 127.0.0.1` once https://github.com/SeismicSystems/summit/pull/434
# is merged. Until then it binds 0.0.0.0 — make sure the NSG doesn't open :3030 publicly.
#
# --genesis-path: written verbatim by tdx-init on every boot from the
# operator POST's summit_genesis_base64 (readable via summit's `conf`
# supplementary group). The network manifest pins its config_digest, so a
# divergent genesis cannot handshake with the cohort.
ExecStart=/usr/bin/summit run \
    --engine-ipc-path /run/reth-engine/api.ipc \
    --genesis-path /run/seismic/conf/summit-genesis.toml \
    --store-path /persistent/summit/db \
    --key-store-path /persistent/summit/keys \
    --port 18551 \
    --rpc-port 3030 \
    --prom-ip 127.0.0.1 \
    --prom-port 9002 \
    --db-prefix quarts \
    --log-level info

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=minimal.target
