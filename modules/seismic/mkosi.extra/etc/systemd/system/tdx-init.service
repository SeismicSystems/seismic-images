[Unit]
Description=TDX initialization (wait for node config via HTTP)
After=network-online.target persistent-mount.service
Wants=network-online.target
Requires=persistent-mount.service

[Service]
Type=oneshot
ExecStart=/usr/bin/tdx-init wait-for-key
RemainAfterExit=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=minimal.target
