#!/bin/bash
# Carry summit's keys from tmpfs into its keystore on /persistent, or confirm
# the keystore already there, then rewrite the public-keys file from the
# keystore. Run once per boot by summit-persist.service, as the summit user,
# after persistent-luks-setup has mounted /persistent.
#
# summit-keygen wrote this boot's keys to /run/seismic/summit/keys before the
# config POST, and the founding harvest pinned their public halves. The
# decision is made from the keystore on disk, never from tmpfs:
#
#   keystore complete   `summit keys show` on it must succeed; the tmpfs keys
#                       are a reboot's throwaway set
#   keystore absent     first boot: copy each tmpfs file in; no tmpfs keys
#                       is a failure, so summit never starts on keys the
#                       manifest did not pin
#   one of its 2 files  an interrupted first copy, finished only if that
#                       file is byte-identical to its tmpfs counterpart;
#                       anything else is refused
#
# Each file lands atomically (temporary name, fsync, rename). The tmpfs keys
# are never deleted: with summit-keygen's --no-overwrite they are their own
# write-once marker until the next reboot empties tmpfs.

set -euo pipefail

TMPFS_KEYS=/run/seismic/summit/keys
KEYSTORE=/persistent/summit/keys
PUBLIC_KEYS=/run/seismic/summit/public-keys.json
# Summit's keystore layout: https://github.com/SeismicSystems/summit/blob/main/node/src/keys.rs
KEY_FILES=(node_key.pem consensus_key.pem)

die() {
    echo "summit-persist: $*" >&2
    exit 1
}

# Copy one key file from tmpfs into the keystore so that, whatever the moment
# of a crash, the keystore holds either no file of that name or the complete
# file, never a truncated one. The copy goes to a hidden temporary name,
# owner-only from the start, and is flushed to disk before the rename puts it
# in place. The rename is atomic because both names are in the same directory.
copy_in() {
    local name=$1
    local tmp="$KEYSTORE/.$name.tmp"
    install -m 0600 "$TMPFS_KEYS/$name" "$tmp"
    sync "$tmp"
    mv -f "$tmp" "$KEYSTORE/$name"
}

# Which of the two key files the keystore already holds decides the case below.
present=()
missing=()
for name in "${KEY_FILES[@]}"; do
    if [[ -e "$KEYSTORE/$name" ]]; then
        present+=("$name")
    else
        missing+=("$name")
    fi
done

case ${#present[@]} in
    2)
        # A reboot: the keystore holds the keys the manifest pinned, and this
        # boot's tmpfs keys are discarded. Confirming it decodes is the
        # `keys show` after the case.
        echo "summit-persist: keystore present; confirming it"
        ;;
    0)
        # First boot. Check both tmpfs files before copying either, so a
        # missing one fails here instead of leaving a half-written keystore.
        for name in "${KEY_FILES[@]}"; do
            [[ -e "$TMPFS_KEYS/$name" ]] ||
                die "no keystore at $KEYSTORE and no $TMPFS_KEYS/$name to copy in"
        done
        for name in "${KEY_FILES[@]}"; do
            copy_in "$name"
        done
        # Flush the directory too, so the renames themselves survive a crash.
        sync "$KEYSTORE"
        echo "summit-persist: copied this boot's keys into $KEYSTORE"
        ;;
    1)
        # A first-boot copy interrupted between the two files. If only this
        # script died, tmpfs still holds the same keys, the file already there
        # matches, and the copy is finished. If the VM rebooted, tmpfs holds
        # fresh keys and the comparison fails: completing the keystore with
        # them would give summit a keypair the manifest never pinned, so the
        # script refuses rather than guess.
        name=${present[0]}
        cmp -s "$KEYSTORE/$name" "$TMPFS_KEYS/$name" ||
            die "partial keystore: $KEYSTORE/$name is not this boot's key; refusing to complete it"
        copy_in "${missing[0]}"
        sync "$KEYSTORE"
        echo "summit-persist: finished an interrupted copy into $KEYSTORE"
        ;;
esac

# Fails unless both keystore files decode. On success, republish the public
# keys from the keystore. On a reboot this replaces the throwaway keys
# summit-keygen published, so the harvest's /v1/keys serves the keys summit
# actually runs with, which the launch checks compare against the manifest.
/usr/bin/summit keys show --json --key-store-path "$KEYSTORE" >"$PUBLIC_KEYS.tmp" ||
    die "summit keys show failed on $KEYSTORE"
mv -f "$PUBLIC_KEYS.tmp" "$PUBLIC_KEYS"
