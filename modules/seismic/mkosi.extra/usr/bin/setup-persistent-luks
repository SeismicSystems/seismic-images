#!/bin/bash
# Provision (first boot) or unlock (subsequent boots) the persistent
# LUKS disk and mount it at /persistent.
#
# Properties of this script:
# - Idempotent: inspects on-disk state and does only what's needed.
# - Prerequisites: The script waits unbounded for 2 things:
#   1. the enclave-server keyfile (fetched from bootnode over the network)
#   2. data-disk attach
# - Exiting: non-zero is reserved for genuinely fatal states; we don't rely on
# systemd to restart this script for transient failures.
#
# Threat model: operator-untrusted, cloud-untrusted. The unlock key
# (storage_key) is derived inside enclave-server from a network-fetched
# root_key and handed to this script via a tmpfs file dropped before
# /persistent mounts. No human or cloud operator ever knows the unlock
# material.
#
# Header-tampering defense (CVE-2025-59054 / CVE-2025-58356):
# https://blog.trailofbits.com/2025/10/30/vulnerabilities-in-luks2-disk-encryption-for-confidential-vms/
# An attacker with disk write access can flip segments[*].encryption to
# cipher_null-ecb; cryptsetup's keyslot KDF still validates with our
# storage_key, but dm-crypt is then configured with the null cipher →
# all subsequent writes land plaintext on disk. We close this in
# userspace per the writeup's recommended Option 1 (MAC the header):
#
#   - First boot: after luksFormat, compute
#       mac = HMAC_SHA256(header_mac_key,
#                        canonical_json({segments, keyslots, digests}))
#     and store it as a custom LUKS2 token (type: seismic-header-mac).
#   - Subsequent boots: recompute MAC over the same canonical subset,
#     compare against the stored token, fail closed on mismatch.
#
# Tokens are excluded from the MAC scope so adding the token after
# format doesn't invalidate the MAC. Detached-header mode on `open`
# closes the TOCTOU window between MAC verify and dm-crypt setup —
# both operations read from the same tmpfs copy of the header.

# -E so the ERR trap below fires on failures inside functions too, letting us
# publish an error status before the boot aborts.
set -Eeuo pipefail

# ERR trap: publish a terminal error status before the boot aborts (systemd
# then retries per Restart=on-failure, overwriting this on the next attempt).
on_error() {
    local rc=$?
    write_status_json "$(jq -cn --arg e "setup-persistent-luks failed (rc=$rc); see journalctl -u persistent-luks-setup.service" \
        '{state:"error", error:$e}' 2>/dev/null)"
    return "$rc"
}
trap on_error ERR

MAPPER_NAME="persistent"
MAPPER_DEVICE="/dev/mapper/${MAPPER_NAME}"
MOUNT_POINT="/persistent"

# First-boot LUKS-wipe progress file, served by enclave-server's
# getLuksProvisioningStatus RPC for the operator CLI's progress bar. We only
# report the *provisioning* wipe — the long (1h+), otherwise-silent phase —
# and remove the file when done so the endpoint reports "idle" afterwards. The
# JSON schema must match enclave-server's `LuksProvisioningStatus` (enclave
# crate, api.rs); the dir comes from tmpfiles.d/seismic-runtime.conf. Writing
# status is strictly best-effort: a hiccup here must never wedge the disk setup.
STATUS_FILE="/run/seismic/status/luks.json"

# Drop-zone for the LUKS keys, written by enclave-server at startup:
# 64 bytes total = storage_key (32B) || header_mac_key (32B).
# TODO(samlaf): consider swapping polling for systemd Type=notify on enclave.service.
# enclave-server would sd_notify(READY=1) after writing the keyfile, and
# this script could drop wait_for_keyfile entirely. Gives clean failure
# propagation if enclave never readies.
KEYFILE="/run/seismic/enclave/luks-keys"

# Detached LUKS header lives here after MAC verification. cryptsetup
# uses this copy for the actual open, closing TOCTOU between verify
# and dm-crypt setup.
HEADER_BACKUP="/run/seismic/luks-header.bin"

# Custom LUKS2 token type that carries our header MAC.
TOKEN_TYPE="seismic-header-mac"

# Default disk glob: Azure attaches the persistent data disk at LUN 10
# by convention (set in deploy/.../azure/api.py::attach_data_disk).
# Override via /etc/seismic-images/persistent-disk-glob (one glob per
# line) for other clouds — GCP uses /dev/disk/by-id/google-<diskname>,
# no LUN concept. TODO: ship the override from the per-cloud mkosi
# profile, e.g. mkosi.profiles/gcp/mkosi.extra/etc/seismic-images/...
DEFAULT_DISK_GLOB="/dev/disk/by-path/*10"
DISK_GLOB_OVERRIDE_FILE="/etc/seismic-images/persistent-disk-glob"

log() { echo "[setup-persistent-luks] $*" >&2; }

# --- LUKS-wipe progress producer (best-effort; never aborts the script) -----
#
# Reports only the first-boot provisioning wipe. All writers swallow their own
# errors: progress telemetry must never be the reason a wipe/unlock fails. The
# file is written atomically (tmp + rename) so the reader never sees a torn
# JSON object. Schema is enclave-server's `LuksProvisioningStatus`:
#   {"state":"provisioning","bytes_done":N,"bytes_total":M[,"eta_seconds":S]}
#   {"state":"error","error":"..."}   (file removed on success → reader: idle)

# Atomically write a JSON document (arg $1) to $STATUS_FILE. Silent no-op on
# any failure (e.g. the status dir not yet present).
write_status_json() {
    local json=$1
    [[ -n "$json" ]] || return 0
    {
        local tmp="${STATUS_FILE}.tmp.$$"
        printf '%s\n' "$json" > "$tmp"
        chmod 0644 "$tmp"          # world-readable: enclave-server reads it as a different user
        mv -f "$tmp" "$STATUS_FILE"
    } 2>/dev/null || true
}

# Publish a byte-progress tick. Guards against non-numeric input (a misparsed
# line must not produce a malformed status). A bytes_total of 0 is reserved for
# the "just starting, no measurement yet" marker written before the wipe.
write_progress_status() {
    local done_bytes=$1 total_bytes=$2 eta_ms=${3:-0}
    [[ "$done_bytes" =~ ^[0-9]+$ && "$total_bytes" =~ ^[0-9]+$ && "$total_bytes" -gt 0 ]] || return 0
    local eta_arg="null"
    [[ "$eta_ms" =~ ^[0-9]+$ && "$eta_ms" -gt 0 ]] && eta_arg=$(( eta_ms / 1000 ))
    write_status_json "$(jq -cn \
        --argjson db "$done_bytes" --argjson tb "$total_bytes" --argjson eta "$eta_arg" \
        '{state:"provisioning", bytes_done:$db, bytes_total:$tb}
         + (if $eta == null then {} else {eta_seconds:$eta} end)' 2>/dev/null)"
}

# Demultiplex cryptsetup's merged stdout+stderr: turn --progress-json ticks
# into status updates, and forward everything else (cryptsetup's own logging)
# to stderr → journald. One parser fed the merged stream, so we depend neither
# on which stream cryptsetup emits JSON on, nor flood journald with the ~1
# line/5s of progress. NOTE: the .device_bytes/.device_size/.eta_ms field
# names are cryptsetup's --progress-json schema (>= 2.4):
# <https://man7.org/linux/man-pages/man8/cryptsetup-luksFormat.8.html>
# If they ever drift, only the % is lost — provisioning still shows.
split_progress_stream() {
    local line parsed done_bytes total_bytes eta_ms
    while IFS= read -r line; do
        if parsed=$(printf '%s' "$line" | jq -er '
                select(.device_bytes != null and .device_size != null)
                | [.device_bytes, .device_size, (.eta_ms // 0)] | @tsv' 2>/dev/null); then
            IFS=$'\t' read -r done_bytes total_bytes eta_ms <<<"$parsed"
            write_progress_status "$done_bytes" "$total_bytes" "$eta_ms"
        else
            printf '%s\n' "$line" >&2
        fi
    done
}

# Block until enclave-server drops the keyfile. The enclave-server
# unit runs in parallel with this script (via systemd Requires=); the
# keyfile is the synchronization point. enclave-server renames the file
# into place, so existence implies fully written.
wait_for_keyfile() {
    local elapsed=0
    while [[ ! -f "$KEYFILE" ]]; do
        if (( elapsed % 30 == 0 )); then
            log "waiting for enclave-server to drop keyfile $KEYFILE (${elapsed}s elapsed)"
        fi
        sleep 1
        elapsed=$(( elapsed + 1 ))
    done
}

# Locate the persistent data disk's block-device path. Walks the globs
# from $DISK_GLOB_OVERRIDE_FILE (one per line) if present, else just
# $DEFAULT_DISK_GLOB; takes the first pattern with a match, resolves
# symlinks, prints the absolute device path on stdout. Non-zero exit
# if nothing matched — caller must check.
discover_disk() {
    local patterns=()
    if [[ -r "$DISK_GLOB_OVERRIDE_FILE" ]]; then
        mapfile -t patterns < "$DISK_GLOB_OVERRIDE_FILE"
    else
        patterns=("$DEFAULT_DISK_GLOB")
    fi

    shopt -s nullglob
    for pattern in "${patterns[@]}"; do
        # shellcheck disable=SC2206  # intentional unquoted glob expansion
        local matches=( $pattern )
        if (( ${#matches[@]} > 0 )); then
            if (( ${#matches[@]} > 1 )); then
                log "WARNING: pattern '$pattern' matched multiple devices: ${matches[*]}; using first"
            fi
            realpath "${matches[0]}"
            return 0
        fi
    done

    log "no persistent disk yet (tried: ${patterns[*]})"
    return 1
}

# Block until the persistent data disk is discoverable; cloud disk
# attach and udev symlink creation can lag early boot.
wait_for_disk() {
    local device
    while true; do
        # Re-trigger so /dev/disk/by-* symlinks appear for late-attached disks.
        udevadm trigger --subsystem-match=block 2>/dev/null || true
        udevadm settle --timeout=30 2>/dev/null || true
        if device=$(discover_disk); then
            printf '%s\n' "$device"
            return 0
        fi
        sleep 5
    done
}

# First-boot LUKS provisioning. Runs only when the disk has no LUKS
# header yet (caller checks with `cryptsetup isLuks`).
#
# This step can be VERY slow on first boot: --integrity hmac-sha256
# makes luksFormat initialize dm-integrity tag metadata for every
# sector, which is effectively a full-device write at format time.
# Multi-TB disks can take an hour+. Subsequent boots take the
# verify_and_open path and skip this.
#
# After this returns, /dev/mapper/persistent is already open (from the
# luksFormat→open sequence below), so the caller can mount without a
# second unlock call.
provision_luks() {
    local device=$1
    local keyfile=$2
    log "first-boot: provisioning LUKS2 on $device"
    # Mark provisioning as started before the first cryptsetup tick (~5s away),
    # so the endpoint never reads "idle" mid-wipe. bytes_total:0 = indeterminate
    # until the first real progress tick arrives.
    write_status_json '{"state":"provisioning","bytes_done":0,"bytes_total":0}'

    # Cipher choice (aes-xts-random + dm-integrity hmac-sha256 no-journal):
    # - aes-xts-random stores a fresh per-sector random IV in dm-integrity's
    #   metadata area. Closes the equality-oracle attack class (snapshot-diff
    #   watermarking + ciphertext side-channels that exploit deterministic
    #   XTS). The random IV is the load-bearing piece; HMAC comes bundled
    #   because cryptsetup doesn't expose random-IV storage without the
    #   integrity layer in any kernel mode.
    # - --key-size 512 = two 256-bit halves for AES-XTS-256 (data + tweak).
    # - --integrity hmac-sha256 → cryptsetup auto-allocates a 256-bit HMAC
    #   key alongside the XTS data key; both come from cryptsetup's CSPRNG,
    #   independent of our storage_key (which is just the unlock material
    #   that decrypts keyslot 0 to recover the master key).
    # - --integrity-no-journal skips dm-integrity's 2× write-amplification
    #   crash journal. A crash mid-write leaves the affected sector reading
    #   as EILSEQ; in the worst case the validator needs to be reprovisioned.
    # - --key-file <(head -c 32 ...) routes the first 32 bytes of the keyfile
    # (storage_key) into cryptsetup via an in-kernel pipe.
    # - --progress-json streams machine-readable wipe progress; split_progress_stream
    # turns each tick into the status file the operator CLI polls, and forwards
    # cryptsetup's own logging (merged via 2>&1) on to journald. The crypto flags
    # are unchanged — this only adds observability. pipefail (set above) keeps a
    # luksFormat failure fatal despite the pipe.
    cryptsetup luksFormat --type luks2 --batch-mode \
        --cipher aes-xts-random \
        --key-size 512 \
        --integrity hmac-sha256 \
        --integrity-no-journal \
        --key-file <(head -c 32 "$keyfile") \
        --progress-json --progress-frequency 5 \
        "$device" 2>&1 | split_progress_stream

    cryptsetup open --key-file <(head -c 32 "$keyfile") "$device" "$MAPPER_NAME"

    log "creating ext4 filesystem on $MAPPER_DEVICE"
    mkfs.ext4 -q "$MAPPER_DEVICE"

    log "computing + storing $TOKEN_TYPE token"
    local mac
    mac=$(compute_header_mac "$device" "$keyfile")
    jq -cn --arg type "$TOKEN_TYPE" --arg mac "$mac" '{type:$type, keyslots:[], mac:$mac}' \
        | cryptsetup token import "$device"
}

# Compute HMAC-SHA256(header_mac_key, canonical_json({segments, keyslots, digests}))
# over the LUKS header in $1. Accepts either a block device or a header-backup file;
# cryptsetup luksDump handles both forms transparently.
compute_header_mac() {
    local header_source=$1
    local keyfile=$2
    # Extract header_mac_key (last 32 bytes of the keyfile) and hex it.
    # openssl HMAC's -macopt only accepts hexkey: on the cmdline, so a
    # one-time hex'ing here is unavoidable.
    local header_mac_key_hex
    header_mac_key_hex=$(tail -c 32 "$keyfile" | xxd -p -c 32)
    cryptsetup luksDump --dump-json-metadata "$header_source" \
        | jq -cS '{segments, keyslots, digests}' \
        | openssl dgst -sha256 -mac HMAC -macopt "hexkey:$header_mac_key_hex" \
        | awk '{print $NF}'
}

# Steady-state unlock path: every boot after the first.
#   1. Back the on-disk header up to tmpfs (snapshot at one point in time).
#   2. Verify HMAC against the seismic-header-mac token in that snapshot.
#   3. cryptsetup open with --header pointing at the snapshot, so
#      dm-crypt is configured from the verified bytes regardless of
#      what's on disk afterwards.
verify_and_open() {
    local device=$1
    local keyfile=$2

    log "backing up LUKS header to tmpfs"
    rm -f "$HEADER_BACKUP"
    cryptsetup luksHeaderBackup "$device" --header-backup-file "$HEADER_BACKUP"

    log "verifying $TOKEN_TYPE token against header content"
    local stored_mac
    stored_mac=$(cryptsetup luksDump --dump-json-metadata "$HEADER_BACKUP" \
        | jq -r --arg type "$TOKEN_TYPE" \
            '.tokens // {} | to_entries[] | select(.value.type == $type) | .value.mac' \
        | head -n1)
    if [[ -z "$stored_mac" ]]; then
        log "ERROR: no $TOKEN_TYPE token on $device — header tampered or disk pre-dates this script"
        return 1
    fi
    local computed_mac
    computed_mac=$(compute_header_mac "$HEADER_BACKUP" "$keyfile")
    if [[ "$stored_mac" != "$computed_mac" ]]; then
        log "ERROR: header MAC mismatch — header has been tampered with (CVE-2025-59054 class attack)"
        log "  stored:   $stored_mac"
        log "  computed: $computed_mac"
        return 1
    fi

    log "opening $device via detached header"
    cryptsetup open \
        --header "$HEADER_BACKUP" \
        --key-file <(head -c 32 "$keyfile") \
        "$device" "$MAPPER_NAME"
}

mount_persistent() {
    if mountpoint -q "$MOUNT_POINT"; then
        log "$MOUNT_POINT already mounted"
        return 0
    fi
    mkdir -p "$MOUNT_POINT"
    log "mounting $MAPPER_DEVICE at $MOUNT_POINT"
    mount "$MAPPER_DEVICE" "$MOUNT_POINT"
}

main() {
    wait_for_keyfile

    # Sanity-check the keyfile shape; consumers below extract their
    # 32-byte slices directly via head -c / tail -c.
    local size
    size=$(stat -c %s "$KEYFILE")
    if (( size != 64 )); then
        log "ERROR: $KEYFILE has wrong size ($size, expected 64)"
        return 1
    fi

    local device
    device=$(wait_for_disk)
    log "persistent disk: $device"

    if cryptsetup isLuks "$device"; then
        verify_and_open "$device" "$KEYFILE"
    else
        # first boot only
        provision_luks "$device" "$KEYFILE"
    fi

    mount_persistent

    # Provisioning (if it ran) is finished and /persistent is mounted — drop the
    # progress file so getLuksProvisioningStatus reports idle from here on.
    rm -f "$STATUS_FILE" 2>/dev/null || true

    # Done with the keyfile — shred so it doesn't linger past use.
    shred -u "$KEYFILE" 2>/dev/null || rm -f "$KEYFILE"
}

main "$@"
