[Unit]
Description=Basic Network Setup
DefaultDependencies=no
Before=network.target network-online.target
Wants=network.target

[Service]
Type=oneshot
ExecStart=ip link set lo up
ExecStart=ip link set eth0 up
ExecStart=chattr +i /etc/resolv.conf
ExecStart=/usr/sbin/udhcpc -i eth0 -n
# Wait for default route to be available
ExecStart=/bin/sh -c 'for i in 1 2 3 4 5; do ip route show default | grep -q default && exit 0; sleep 1; done; exit 1'
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target network-online.target
