#!/bin/bash
set -euo pipefail

# GCP-specific post-installation script
# Installs Google Cloud packages that aren't available in Debian repos

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Installing Google Cloud packages"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Configuration
UBUNTU_RELEASE="noble"  # Ubuntu 24.04 LTS
UBUNTU_MIRROR="http://archive.ubuntu.com/ubuntu"
temp_dir=$(mktemp -d)
trap "rm -rf $temp_dir" EXIT

cd "$temp_dir"

# Download Google packages from Ubuntu repos
echo "Downloading google-guest-agent..."
curl -fsSL "${UBUNTU_MIRROR}/pool/main/g/google-guest-agent/google-guest-agent_20250116.00-0ubuntu1~24.04.2_amd64.deb" \
    -o google-guest-agent.deb || echo "Warning: Could not download google-guest-agent"

echo "Downloading google-compute-engine-oslogin..."
curl -fsSL "${UBUNTU_MIRROR}/pool/universe/g/google-compute-engine-oslogin/google-compute-engine-oslogin_20240626.00-0ubuntu1_amd64.deb" \
    -o google-oslogin.deb || echo "Warning: Could not download google-compute-engine-oslogin"

# Install packages if downloaded
for deb in *.deb; do
    if [ -f "$deb" ]; then
        echo "Installing $deb..."
        dpkg -i "$deb" || apt-get install -f -y
    fi
done

# Enable google-guest-agent service
if [ -f /lib/systemd/system/google-guest-agent.service ]; then
    systemctl enable google-guest-agent.service
    echo "✓ google-guest-agent service enabled"
fi

# Enable google-oslogin services
if [ -f /lib/systemd/system/google-oslogin-cache.service ]; then
    systemctl enable google-oslogin-cache.service
    echo "✓ google-oslogin-cache service enabled"
fi

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Google Cloud packages installed successfully"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
