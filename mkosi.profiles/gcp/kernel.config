# Google Virtual NIC driver, also important for GCP
CONFIG_GVE=y
CONFIG_NET_VENDOR_GOOGLE=y

# Set in flashbots PR
CONFIG_NVME_AUTH=y
CONFIG_NVME_MULTIPATH=y
CONFIG_NVME_VERBOSE_ERRORS=y
CONFIG_NVME_FABRICS=y
CONFIG_NVME_FC=y
CONFIG_NVME_TCP=y
CONFIG_NVME_HOST_AUTH=y
CONFIG_NVME_TARGET=y

# From Rodd @ GCP:
# Software I/O Translation Lookaside Buffer, often necessary in virtualized and IOMMU scenarios.
CONFIG_SWIOTLB=y
# Enables X2APIC support, a dependency for TDX guest support.
CONFIG_X86_X2APIC=y
# Support for booting EFI kernels.
CONFIG_EFI_STUB=y
# Support for running as a KVM guest.
CONFIG_KVM_GUEST=y
# Generic paravirtualization support.
CONFIG_PARAVIRT=y
# Enables the fundamental kernel support for running as an Intel TDX guest.
CONFIG_INTEL_TDX_GUEST=y
# Enables the guest device driver (e.g., for /dev/tdx_guest) interface for TDX features like attestation.
CONFIG_TDX_GUEST_DRIVER=y
# Likely related to a Trusted Security Module for attestation reports
CONFIG_TSM_REPORTS=y

# Critical configs for TDX NVMe DMA to work
# KVM paravirtualization
CONFIG_KVM_CLOCK=y

# PCI MSI/MSI-X support (critical for NVMe interrupts)
CONFIG_PCI_MSI=y
CONFIG_GENERIC_MSI_IRQ=y
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEASPM=y

# GCP boot requirements
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y

# ============================================================================
# 2025-01-06: Claude Code Analysis & Configuration Updates for GCP NVMe Issues
# ============================================================================
# Problem: DMA direct warnings and disk I/O failures on GCP VMs with NVMe persistent disks
# Root Cause: Missing SWIOTLB/DMA bounce buffer configs + problematic kernel cmdline params
# Expert Input: Rodd Zurcher @ GCP provided critical analysis of DMA/SWIOTLB requirements

# CRITICAL SWIOTLB/DMA FIXES (per Rodd@GCP expert analysis):
# --------------------------------------------------------
# TDX guest memory is private/encrypted - devices MUST use shared bounce buffers for DMA
# System was requesting 1GB SWIOTLB but only getting 512MB, causing DMA allocation failures

CONFIG_SWIOTLB=y                    # Software I/O TLB for DMA bounce buffers (CRITICAL)
CONFIG_SWIOTLB_DYNAMIC=y           # Auto-sizing to get full 1GB buffer (CRITICAL)  
CONFIG_DMA_BOUNCE=y                # DMA bounce buffer support
CONFIG_DMA_COHERENT_POOL=y         # DMA coherent memory pool
CONFIG_DMA_ENGINE=y                # DMA engine framework

# IOMMU configs - let system auto-detect, don't force defaults
# (Removed intel_iommu=on from kernel cmdline per Rodd's advice)
CONFIG_INTEL_IOMMU=y               # Intel IOMMU support
CONFIG_INTEL_IOMMU_FLOPPY_WA=y     # Floppy DMA workaround
CONFIG_IOMMU_SUPPORT=y             # Generic IOMMU support
CONFIG_IOMMUFD=y                   # IOMMU file descriptor interface
CONFIG_IOMMU_HELPER=y              # IOMMU helper functions

# Architecture DMA support
CONFIG_ARCH_HAS_DMA_OPS=y          # Architecture has DMA operations
CONFIG_ARCH_HAS_ZONE_DMA_SET=y     # Architecture DMA zone support

# DMA debugging (to troubleshoot remaining issues)
CONFIG_IOMMU_DEBUGFS=y             # IOMMU debug filesystem
CONFIG_IOMMU_DEBUG=y               # IOMMU debug support  
CONFIG_DMA_API_DEBUG=y             # DMA API debug support
CONFIG_DMA_MAP_BENCHMARK=y         # DMA mapping benchmarks

# AI SLOP: Additional NVMe/Storage configs that were missing in seismic
# ===================================================================
# These were enabled in Ubuntu but disabled/missing in seismic kernel config

# Essential NVMe hardware monitoring and tracing
CONFIG_NVME_HWMON=y                # NVMe hardware monitoring via hwmon
CONFIG_BLK_DEV_IO_TRACE=y          # Block I/O tracing (for GCP monitoring)

# Device detection and management 
CONFIG_DM_UEVENT=y                 # Device mapper uevents (for auto-mounting)
CONFIG_BLK_DEV_BSG=y               # Block SCSI Generic interface
CONFIG_SCSI_CONSTANTS=y            # SCSI error constants
CONFIG_SCSI_LOGGING=y              # SCSI debug logging
CONFIG_SCSI_SCAN_ASYNC=y           # Async SCSI scanning
CONFIG_SCSI_FC_ATTRS=y             # SCSI Fibre Channel attributes

# VirtIO advanced features for GCP memory scaling
CONFIG_VIRTIO_MEM=y                # VirtIO memory hotplug
CONFIG_VIRTIO_PMEM=y               # VirtIO persistent memory

# Modern NVMe features
CONFIG_NVME_TARGET_AUTH=y          # NVMe target authentication
CONFIG_NVME_TARGET_PASSTHRU=y      # NVMe target passthrough
CONFIG_BLK_DEV_ZONED=y             # Zoned block devices (modern NVMe ZNS)

# Advanced encryption stack for persistent disks
CONFIG_BLK_INLINE_ENCRYPTION=y     # Block layer inline encryption
CONFIG_FS_ENCRYPTION=y             # Filesystem encryption
CONFIG_CRYPTO_CTR=y                # Counter mode encryption
CONFIG_CRYPTO_GCM=y                # Galois/Counter mode
CONFIG_CRYPTO_GHASH=y              # GHASH for authenticated encryption

# Storage redundancy and device mapper features
CONFIG_BLK_DEV_MD=y                # Multiple device (software RAID)
CONFIG_DM_INIT=y                   # Device mapper initialization

# Network block devices (may be used by GCP)
CONFIG_BLK_DEV_RNBD=y              # Remote network block device
CONFIG_BLK_DEV_RNBD_CLIENT=y       # RNBD client support

# Persistent memory support
CONFIG_BLK_DEV_PMEM=y              # Persistent memory block device

# VFIO device passthrough
CONFIG_VFIO_IOMMU_TYPE1=y          # VFIO IOMMU type 1
CONFIG_VFIO_NOIOMMU=y              # VFIO no-IOMMU mode

# KVM virtualization stack
CONFIG_KVM_INTEL=y                 # Intel KVM support
CONFIG_KVM_AMD=y                   # AMD KVM support  
CONFIG_KVM_COMMON=y                # Common KVM functionality
CONFIG_KVM_ASYNC_PF=y              # KVM async page faults
CONFIG_KVM_HYPERV=y                # Hyper-V compatibility
CONFIG_KVM_GENERIC_DIRTYLOG_READ_PROTECT=y
CONFIG_KVM_GENERIC_HARDWARE_ENABLING=y
CONFIG_KVM_GENERIC_MEMORY_ATTRIBUTES=y
CONFIG_KVM_GENERIC_MMU_NOTIFIER=y

# IRQ and MSI support (critical for NVMe interrupts in VMs)
CONFIG_GENERIC_IRQ_CHIP=y          # Generic IRQ chip support
CONFIG_IRQ_BYPASS_MANAGER=y        # IRQ bypass for virtualization
CONFIG_HAVE_KVM_IRQ_BYPASS=y       # KVM IRQ bypass support
CONFIG_HAVE_KVM_IRQ_ROUTING=y      # KVM IRQ routing
CONFIG_HAVE_KVM_MSI=y              # KVM MSI support

# PCI hotplug for dynamic disk attachment
CONFIG_HOTPLUG_PCI_ACPI_IBM=y      # IBM ACPI PCI hotplug
CONFIG_HOTPLUG_PCI_CPCI_GENERIC=y  # Generic CompactPCI hotplug

# VirtIO graphics (ensuring it stays enabled)
CONFIG_DRM_VIRTIO_GPU=y            # VirtIO GPU driver