# Google Virtual NIC driver, also important for GCP
CONFIG_GVE=y
CONFIG_NET_VENDOR_GOOGLE=y

# Set in flashbots PR
CONFIG_NVME_AUTH=y
CONFIG_NVME_MULTIPATH=y
CONFIG_NVME_VERBOSE_ERRORS=y
CONFIG_NVME_FABRICS=y
CONFIG_NVME_FC=y
CONFIG_NVME_TCP=y
CONFIG_NVME_HOST_AUTH=y
CONFIG_NVME_TARGET=y

# From Rodd @ GCP:
# Software I/O Translation Lookaside Buffer, often necessary in virtualized and IOMMU scenarios.
CONFIG_SWIOTLB=y
# Enables X2APIC support, a dependency for TDX guest support.
CONFIG_X86_X2APIC=y
# Support for booting EFI kernels.
CONFIG_EFI_STUB=y
# Support for running as a KVM guest.
CONFIG_KVM_GUEST=y
# Generic paravirtualization support.
CONFIG_PARAVIRT=y
# Enables the fundamental kernel support for running as an Intel TDX guest.
CONFIG_INTEL_TDX_GUEST=y
# Enables the guest device driver (e.g., for /dev/tdx_guest) interface for TDX features like attestation.
CONFIG_TDX_GUEST_DRIVER=y
# Likely related to a Trusted Security Module for attestation reports
CONFIG_TSM_REPORTS=y

# Critical configs for TDX NVMe DMA to work
# KVM paravirtualization
CONFIG_KVM_CLOCK=y

# PCI MSI/MSI-X support (critical for NVMe interrupts)
CONFIG_PCI_MSI=y
CONFIG_GENERIC_MSI_IRQ=y
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEASPM=y

# GCP boot requirements
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y

# Essential NVMe and storage configs for GCP persistent disks
CONFIG_NVME_HWMON=y
CONFIG_BLK_DEV_IO_TRACE=y
CONFIG_DM_UEVENT=y
CONFIG_BLK_DEV_BSG=y
CONFIG_SCSI_CONSTANTS=y
CONFIG_SCSI_LOGGING=y
CONFIG_SCSI_SCAN_ASYNC=y

# VirtIO Advanced Features for GCP memory scaling
CONFIG_VIRTIO_MEM=y
CONFIG_VIRTIO_PMEM=y

# NVMe Target Authentication and Passthrough
CONFIG_NVME_TARGET_AUTH=y
CONFIG_NVME_TARGET_PASSTHRU=y

# Block Device Zoned Storage (for modern NVMe)
CONFIG_BLK_DEV_ZONED=y

# Advanced Encryption for GCP persistent disks
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_FS_ENCRYPTION=y

# Software RAID and Device Mapper Init
CONFIG_BLK_DEV_MD=y
CONFIG_DM_INIT=y

# Network Block Devices (may be used by GCP)
CONFIG_BLK_DEV_RNBD=y
CONFIG_BLK_DEV_RNBD_CLIENT=y

# Persistent Memory Support
CONFIG_BLK_DEV_PMEM=y

# SCSI FC Attributes (for network storage)
CONFIG_SCSI_FC_ATTRS=y

# Additional crypto that may be needed
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_GHASH=y

# VirtIO Graphics (already enabled in seismic, ensuring it stays)
CONFIG_DRM_VIRTIO_GPU=y

# CRITICAL: Based on Rodd@GCP expert advice - SWIOTLB bounce buffers are KEY for TDX
# Don't force IOMMU on/off - let system auto-detect, but ensure SWIOTLB works properly

# SWIOTLB (Software I/O TLB) - CRITICAL for TDX DMA bounce buffers
# System should auto-configure size, don't override with kernel params
CONFIG_SWIOTLB=y
CONFIG_SWIOTLB_DYNAMIC=y
CONFIG_DMA_BOUNCE=y

# IOMMU support but let system decide when to use it (don't force with =DEFAULT_ON)
# Removing INTEL_IOMMU_DEFAULT_ON per Rodd's advice about iommu=nopt
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_FLOPPY_WA=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMUFD=y

# DMA and bounce buffer support (essential for TDX private memory)
CONFIG_DMA_COHERENT_POOL=y
CONFIG_DMA_ENGINE=y
CONFIG_ARCH_HAS_DMA_OPS=y
CONFIG_ARCH_HAS_ZONE_DMA_SET=y
CONFIG_IOMMU_HELPER=y

# Debug support to troubleshoot SWIOTLB/DMA issues
CONFIG_IOMMU_DEBUGFS=y
CONFIG_IOMMU_DEBUG=y
CONFIG_DMA_API_DEBUG=y
CONFIG_DMA_MAP_BENCHMARK=y

# VFIO for proper device passthrough
CONFIG_VFIO_IOMMU_TYPE1=y
CONFIG_VFIO_NOIOMMU=y

# KVM and virtualization stack
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_KVM_COMMON=y
CONFIG_KVM_ASYNC_PF=y
CONFIG_KVM_HYPERV=y
CONFIG_KVM_GENERIC_DIRTYLOG_READ_PROTECT=y
CONFIG_KVM_GENERIC_HARDWARE_ENABLING=y
CONFIG_KVM_GENERIC_MEMORY_ATTRIBUTES=y
CONFIG_KVM_GENERIC_MMU_NOTIFIER=y

# IRQ and MSI support (critical for NVMe interrupts)
CONFIG_GENERIC_IRQ_CHIP=y
CONFIG_IRQ_BYPASS_MANAGER=y
CONFIG_HAVE_KVM_IRQ_BYPASS=y
CONFIG_HAVE_KVM_IRQ_ROUTING=y
CONFIG_HAVE_KVM_MSI=y

# PCI hotplug for dynamic disk attachment
CONFIG_HOTPLUG_PCI_ACPI_IBM=y
CONFIG_HOTPLUG_PCI_CPCI_GENERIC=y