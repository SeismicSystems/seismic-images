# GCP-specific kernel configs for TDX
# Required by GCP TDX documentation
CONFIG_GVE=y
CONFIG_NET_VENDOR_GOOGLE=y

# Additional TDX/IOMMU/DMA configs for GCP TDX NVMe
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_DMA_RESTRICTED_POOL=y
CONFIG_DMA_COHERENT_POOL=y
CONFIG_IOMMU_DEFAULT_DMA_STRICT=n

# Device mapper and encryption support for cryptsetup
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
