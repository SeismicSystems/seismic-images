[Unit]
Description=Grant the tpm group access to the TDX quote interfaces
After=sys-kernel-config.mount systemd-tmpfiles-setup.service
Before=attestation.service
ConditionPathExists=/sys/kernel/config/tsm

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/setup-gcp-quote-access

[Install]
WantedBy=minimal.target
