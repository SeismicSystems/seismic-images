#!/bin/bash
# Hand the TDX quote interfaces to the tpm group, the way the udev rule hands
# /dev/tpm0 to it on Azure: configfs-tsm creates report attributes root:root
# 0600, and the ACPI CCEL table the platform metadata reads is root 0400,
# while the attestation service quotes as its own user. The SMBIOS memory
# devices it also reads exist on both clouds, so
# /etc/tmpfiles.d/seismic-smbios.conf hands those over instead.
set -euo pipefail

# One image boots both clouds; only GCE has these interfaces to hand over.
[ "$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null)" = Google ] || exit 0

ccel=/sys/firmware/acpi/tables/data/CCEL
if [ -e "$ccel" ]; then
    chgrp tpm "$ccel"
    chmod 0440 "$ccel"
fi

base=/sys/kernel/config/tsm/report
[ -d "$base" ] || exit 0
dir="$base/seismic-attestation"
mkdir -p "$dir"
chgrp tpm "$dir"/inblob "$dir"/outblob "$dir"/generation "$dir"/provider
chmod 0660 "$dir"/inblob
chmod 0440 "$dir"/outblob "$dir"/generation "$dir"/provider
