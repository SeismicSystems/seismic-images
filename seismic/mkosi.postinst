#!/bin/bash
set -euxo pipefail

# Verify binaries were installed
if [ ! -f "$BUILDROOT/usr/bin/summit" ]; then
    echo "Error: summit binary not found"
    exit 1
fi

if [ ! -f "$BUILDROOT/usr/bin/seismic-reth" ]; then
    echo "Error: seismic-reth binary not found"
    exit 1
fi

if [ ! -f "$BUILDROOT/usr/bin/seismic-enclave-server" ]; then
    echo "Error: seismic-enclave-server binary not found"
    exit 1
fi

# Fix PATH for sudo commands so tdx-init can find cryptsetup at /usr/sbin
# Note: bob-common's sudoers file allows 'searcher' to run tdx-init, but needs /usr/sbin in PATH
cat > "$BUILDROOT/etc/sudoers.d/10-seismic-path" << 'EOF'
Defaults secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EOF
chmod 440 "$BUILDROOT/etc/sudoers.d/10-seismic-path"

# NOTE: Seismic uses bob-common's SSH configuration as-is:
# - Production builds: dropbear with security flags (key-only, no root)
# - Dev builds: devtools profile removes dropbear security flags
# - All builds: port 22 via dropbear (from bob-common)

# Configure iptables to use legacy backend (kernel doesn't support nftables)
mkosi-chroot update-alternatives --set iptables /usr/sbin/iptables-legacy
mkosi-chroot update-alternatives --set ip6tables /usr/sbin/ip6tables-legacy

# Create groups and users for Seismic services
mkosi-chroot groupadd -r seismic || true
mkosi-chroot groupadd -r tss || true  # TPM group, may already exist
mkosi-chroot useradd -r -s /bin/false -G seismic summit || true
mkosi-chroot useradd -r -s /bin/false -G seismic seismic-reth || true
mkosi-chroot useradd -r -s /bin/false -G seismic,tss enclave || true

# Create persistent directories for each service
# Note: These directories will be on the persistent disk mount
# Ownership will be set at runtime by the service ExecStartPre commands
mkdir -p "$BUILDROOT/persistent/summit"
mkdir -p "$BUILDROOT/persistent/seismic-reth"
mkdir -p "$BUILDROOT/persistent/enclave"

# Set binary permissions
chmod 755 "$BUILDROOT/usr/bin/summit"
chmod 755 "$BUILDROOT/usr/bin/seismic-reth"
chmod 755 "$BUILDROOT/usr/bin/seismic-enclave-server"

# Set script permissions
chmod 755 "$BUILDROOT/usr/bin/setup-ssl"

# Create directories for nginx and seismic
mkdir -p "$BUILDROOT/var/lib/seismic"
mkdir -p "$BUILDROOT/etc/seismic"
mkdir -p "$BUILDROOT/var/log/nginx"
mkdir -p "$BUILDROOT/etc/nginx"
mkdir -p "$BUILDROOT/usr/share/seismic"

# Enable services
mkdir -p "$BUILDROOT/etc/systemd/system/minimal.target.wants"
mkdir -p "$BUILDROOT/etc/systemd/system/multi-user.target.wants"
mkdir -p "$BUILDROOT/etc/systemd/system/timers.target.wants"

# Enable bob-common services needed by Seismic
# Note: bob-common's postinst runs first and enables all BOB services.
# We explicitly enable only what Seismic needs and disable BOB-specific services.
for service in \
    network-setup.service \
    wait-for-key.service \
    searcher-firewall.service \
    dropbear.service
do
    mkosi-chroot systemctl enable "$service"
    ln -sf "/etc/systemd/system/$service" "$BUILDROOT/etc/systemd/system/minimal.target.wants/"
done

# Disable BOB-specific services that Seismic doesn't need
for service in \
    searcher-container.service \
    fluent-bit.service \
    ssh-pubkey-server.service \
    cvm-reverse-proxy.service
do
    mkosi-chroot systemctl disable "$service" || true
    mkosi-chroot systemctl mask "$service" || true
done

# Enable Seismic services
for service in \
    seismic-reth.service \
    summit.service \
    seismic-enclave-server.service \
    openntpd.service
do
    mkosi-chroot systemctl enable "$service"
    ln -sf "/etc/systemd/system/$service" "$BUILDROOT/etc/systemd/system/minimal.target.wants/"
done

# Enable nginx and SSL setup
for service in \
    setup-ssl.service \
    nginx.service
do
    mkosi-chroot systemctl enable "$service"
    ln -sf "/etc/systemd/system/$service" "$BUILDROOT/etc/systemd/system/multi-user.target.wants/"
done

# Enable certbot renewal timer
mkosi-chroot systemctl enable certbot-renew.timer
ln -sf "/etc/systemd/system/certbot-renew.timer" "$BUILDROOT/etc/systemd/system/timers.target.wants/"

echo "Seismic module post-installation completed successfully"
