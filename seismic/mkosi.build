#!/bin/bash
set -euxo pipefail

source scripts/make_git_package.sh

# Install Rust 1.91 via rustup in chroot (Debian cargo is too old)
mkosi-chroot bash -c '
    curl --proto =https --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.91 --profile minimal --no-modify-path
    export PATH="$HOME/.cargo/bin:$PATH"
    rustc --version
    cargo --version
'

# Branches & commit hashes for reproducible builds
TDX_INIT_COMMIT="660b1edb82360fde18710994b531fd8346cc9f5d"
RETH_COMMIT="a61f4f675a5797d17f043ae04eb3f43de7cbcebb"
ENCLAVE_COMMIT="90d53fd7c49600d78d0ab815869d05e2f4187ca8"
SUMMIT_COMMIT="695ddc7b13abfee4e2c1624fa9693a8700b8c28e"
STAKING_COMMIT="cb410b3a9a61b5f0cc48c67f527d3c1875db55ed"

# Build tdx-init (using Seismic fork with JSON config support)
TDX_INIT_BUILD_CMD="
    cd tdx-init-rs
    export PATH=\"\$HOME/.cargo/bin:\$PATH\"
    cargo build --release --target-dir ./build
"
make_git_package \
    "tdx-init" \
    "$TDX_INIT_COMMIT" \
    "https://github.com/SeismicSystems/tdx-init" \
    "$TDX_INIT_BUILD_CMD" \
    "tdx-init-rs/build/release/tdx-init:/usr/bin/tdx-init"

# Build seismic-reth
RETH_BUILD_CMD="
    git checkout $RETH_COMMIT
    export PATH=\"\$HOME/.cargo/bin:\$PATH\"
    export RUSTFLAGS='-C target-cpu=generic -C link-arg=-Wl,--build-id=none -C symbol-mangling-version=v0'
    export CARGO_PROFILE_RELEASE_LTO='thin'
    export CARGO_PROFILE_RELEASE_CODEGEN_UNITS='1'
    export CARGO_PROFILE_RELEASE_PANIC='abort'
    export CARGO_PROFILE_RELEASE_STRIP='none'
    export CARGO_PROFILE_RELEASE_OPT_LEVEL='3'

    cargo fetch
    cargo build --release --frozen --bin seismic-reth
"
make_git_package \
    "seismic-reth" \
    "$RETH_COMMIT" \
    "https://github.com/SeismicSystems/seismic-reth" \
    "$RETH_BUILD_CMD" \
    "target/release/seismic-reth:/usr/bin/seismic-reth" \
    "crates/seismic/chainspec/res/genesis/dev.json:/usr/share/seismic-reth/genesis.json"

# Build enclave (seismic-enclave-server)
ENCLAVE_BUILD_CMD="
    git checkout $ENCLAVE_COMMIT
    export PATH=\"\$HOME/.cargo/bin:\$PATH\"
    export RUSTFLAGS='-C target-cpu=generic -C link-arg=-Wl,--build-id=none -C symbol-mangling-version=v0'
    export CARGO_PROFILE_RELEASE_LTO='off'
    export CARGO_PROFILE_RELEASE_CODEGEN_UNITS='1'
    export CARGO_PROFILE_RELEASE_PANIC='abort'
    export CARGO_PROFILE_RELEASE_STRIP='none'
    export CARGO_PROFILE_RELEASE_OPT_LEVEL='z'

    cargo fetch
    cargo build --release --frozen --bin seismic-enclave-server
"
make_git_package \
    "enclave" \
    "$ENCLAVE_COMMIT" \
    "https://github.com/SeismicSystems/enclave" \
    "$ENCLAVE_BUILD_CMD" \
    "target/release/seismic-enclave-server:/usr/bin/seismic-enclave-server"

# Build summit (summit)
SUMMIT_BUILD_CMD="
    git checkout $SUMMIT_COMMIT
    export PATH=\"\$HOME/.cargo/bin:\$PATH\"
    export RUSTFLAGS='-C target-cpu=generic -C link-arg=-Wl,--build-id=none -C symbol-mangling-version=v0'
    export CARGO_PROFILE_RELEASE_LTO='thin'
    export CARGO_PROFILE_RELEASE_CODEGEN_UNITS='1'
    export CARGO_PROFILE_RELEASE_PANIC='abort'
    export CARGO_PROFILE_RELEASE_STRIP='none'
    export CARGO_PROFILE_RELEASE_OPT_LEVEL='3'

    cargo fetch
    cargo build --release --frozen --bin summit --features prom
"
make_git_package \
    "summit" \
    "$SUMMIT_COMMIT" \
    "https://github.com/SeismicSystems/summit" \
    "$SUMMIT_BUILD_CMD" \
    "target/release/summit:/usr/bin/summit"

STAKING_BUILD_CMD="
    git checkout $STAKING_COMMIT
    npm install --legacy-peer-deps
    export PATH=\"\$PWD/node_modules/.bin:\$PATH\"
    npm run build
"

make_git_package \
   "staking-ui" \
   "$STAKING_COMMIT" \
   "https://github.com/SeismicSystems/staking-ui" \
   "$STAKING_BUILD_CMD" \
   "dist:/var/www/html/staking"

# Install Prometheus
PROM_VERSION=$(curl -s https://api.github.com/repos/prometheus/prometheus/releases/latest | grep tag_name | cut -d '"' -f 4 | cut -c 2-)
echo "Installing Prometheus version ${PROM_VERSION}"
curl -L "https://github.com/prometheus/prometheus/releases/download/v${PROM_VERSION}/prometheus-${PROM_VERSION}.linux-amd64.tar.gz" -o /tmp/prometheus.tar.gz
tar -xzf /tmp/prometheus.tar.gz -C /tmp
mkdir -p "$DESTDIR/usr/bin"
install -m 755 "/tmp/prometheus-${PROM_VERSION}.linux-amd64/prometheus" "$DESTDIR/usr/bin/prometheus"
install -m 755 "/tmp/prometheus-${PROM_VERSION}.linux-amd64/promtool" "$DESTDIR/usr/bin/promtool"
rm -rf /tmp/prometheus*

# Install Grafana
echo "Installing Grafana"
GRAFANA_VERSION="12.2.1"
curl -L "https://dl.grafana.com/oss/release/grafana-${GRAFANA_VERSION}.linux-amd64.tar.gz" -o /tmp/grafana.tar.gz
tar -xzf /tmp/grafana.tar.gz -C /tmp
mkdir -p "$DESTDIR/usr/share/grafana"
mkdir -p "$DESTDIR/usr/sbin"
cp -r /tmp/grafana-${GRAFANA_VERSION}/* "$DESTDIR/usr/share/grafana/"
ln -sf /usr/share/grafana/bin/grafana "$DESTDIR/usr/sbin/grafana"
ln -sf /usr/share/grafana/bin/grafana-cli "$DESTDIR/usr/sbin/grafana-cli"
rm -rf /tmp/grafana*
