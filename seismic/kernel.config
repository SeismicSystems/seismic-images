# Seismic-specific kernel configuration
# TPM 2.0 support for attestation
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_TIS_CORE=y
CONFIG_TCG_CRB=y

# Hardware random number generator (needed for TPM)
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_TPM=y

# Crypto support for TDX attestation
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
