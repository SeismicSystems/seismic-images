#!/bin/bash
set -euo pipefail

CONFIG_FILE="/etc/tdx-init/config.json"
TEMPLATE="/etc/nginx-rpc-template.conf"
NGINX_CONF="/persistent/conf/nginx-rpc.conf"
NGINX_ENABLED="/etc/nginx/sites-enabled/default"
CERTBOT_DONE="/persistent/conf/.certbot-done"

# Check if config exists
if [ ! -f "$CONFIG_FILE" ]; then
    echo "Config file not found: $CONFIG_FILE"
    echo "Run tdx-init first to create the config"
    exit 1
fi

# Extract domain name from config
DOMAIN_NAME=$(jq -r '.domain.name' "$CONFIG_FILE")
DOMAIN_EMAIL=$(jq -r '.domain.email' "$CONFIG_FILE")

if [ -z "$DOMAIN_NAME" ] || [ "$DOMAIN_NAME" = "null" ]; then
    echo "No domain name found in config, skipping nginx/SSL setup"
    exit 0
fi

echo "Setting up nginx for domain: $DOMAIN_NAME"

# Generate nginx config from template
sed "s/DOMAIN_NAME_PLACEHOLDER/$DOMAIN_NAME/g" "$TEMPLATE" > "$NGINX_CONF"

# Create symlink to nginx sites-enabled
mkdir -p /etc/nginx/sites-enabled
rm -f "$NGINX_ENABLED"
ln -s "$NGINX_CONF" "$NGINX_ENABLED"

# Remove default site
rm -f /etc/nginx/sites-enabled/default

# Test nginx config
nginx -t

# Start/reload nginx
systemctl enable nginx
systemctl restart nginx

# Run certbot if not already done
if [ ! -f "$CERTBOT_DONE" ]; then
    echo "Running certbot for $DOMAIN_NAME with email $DOMAIN_EMAIL"

    # Wait for nginx to be fully up
    sleep 2

    # Run certbot
    certbot --nginx \
        --non-interactive \
        --agree-tos \
        --email "$DOMAIN_EMAIL" \
        --domain "$DOMAIN_NAME" \
        --redirect

    # Mark as done
    touch "$CERTBOT_DONE"

    echo "SSL certificate obtained successfully"
else
    echo "Certbot already run, skipping (remove $CERTBOT_DONE to re-run)"
fi

echo "Nginx SSL setup complete"
echo "Endpoints available at:"
echo "  https://$DOMAIN_NAME/rpc"
echo "  https://$DOMAIN_NAME/ws"
echo "  https://$DOMAIN_NAME/summit"
