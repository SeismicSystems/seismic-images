#!/bin/bash
set -euo pipefail

CONFIG_FILE="/persistent/conf/node.json"
NODE_TEMPLATE="/etc/nginx/node-template.conf"
GRAFANA_TEMPLATE="/etc/nginx/grafana-template.conf"
NODE_NGINX_CONF="/persistent/conf/node-nginx.conf"
GRAFANA_NGINX_CONF="/persistent/conf/grafana-nginx.conf"
NODE_NGINX_ENABLED="/etc/nginx/sites-enabled/node"
GRAFANA_NGINX_ENABLED="/etc/nginx/sites-enabled/grafana"
CERTBOT_DONE="/persistent/conf/.certbot-done"

# Certbot directories in /persistent/conf/certbot/
CERTBOT_CONFIG_DIR="/persistent/conf/certbot"
CERTBOT_WORK_DIR="/persistent/conf/certbot/work"
CERTBOT_LOGS_DIR="/persistent/conf/certbot/logs"

# Check if config exists
if [ ! -f "$CONFIG_FILE" ]; then
    echo "Config file not found: $CONFIG_FILE"
    echo "Run tdx-init first to create the config"
    exit 1
fi

# Extract domain name from config
DOMAIN_NAME=$(jq -r '.domain.name' "$CONFIG_FILE")
DOMAIN_EMAIL=$(jq -r '.domain.email' "$CONFIG_FILE")

if [ -z "$DOMAIN_NAME" ] || [ "$DOMAIN_NAME" = "null" ]; then
    echo "No domain name found in config, skipping nginx/SSL setup"
    exit 0
fi

echo "Setting up nginx for domains: $DOMAIN_NAME and metrics.$DOMAIN_NAME"

# Create persistent directories
mkdir -p /persistent/conf
mkdir -p "$CERTBOT_CONFIG_DIR" "$CERTBOT_WORK_DIR" "$CERTBOT_LOGS_DIR"

# Generate nginx configs from templates (only if certbot hasn't run yet)
if [ ! -f "$CERTBOT_DONE" ]; then
    echo "Generating node nginx config from template"
    sed "s/DOMAIN_NAME_PLACEHOLDER/$DOMAIN_NAME/g" "$NODE_TEMPLATE" > "$NODE_NGINX_CONF"

    echo "Generating grafana nginx config from template"
    sed "s/DOMAIN_NAME_PLACEHOLDER/$DOMAIN_NAME/g" "$GRAFANA_TEMPLATE" > "$GRAFANA_NGINX_CONF"
else
    echo "Certbot already configured, preserving existing nginx configs"
fi

# Generate config for Staking UI
STAKING_ROOT="/var/www/html/staking"
if [ -d "$STAKING_ROOT" ]; then
    echo "Generating Staking UI config"
    # Write config.js with the domain/endpoints
    cat > "$STAKING_ROOT/config.js" <<EOF
window.APP_CONFIG = {
    domain: "$DOMAIN_NAME",
    rpcUrl: "https://$DOMAIN_NAME/rpc",
    wsUrl: "wss://$DOMAIN_NAME/ws"
};
EOF
fi

# Create symlinks to nginx sites-enabled
mkdir -p /etc/nginx/sites-enabled

# Remove old default symlink if it exists
rm -f /etc/nginx/sites-enabled/default

# Create node symlink
rm -f "$NODE_NGINX_ENABLED"
ln -s "$NODE_NGINX_CONF" "$NODE_NGINX_ENABLED"

# Create grafana symlink
rm -f "$GRAFANA_NGINX_ENABLED"
ln -s "$GRAFANA_NGINX_CONF" "$GRAFANA_NGINX_ENABLED"

# Verify symlinks were created
if [ ! -L "$NODE_NGINX_ENABLED" ]; then
    echo "ERROR: Failed to create symlink at $NODE_NGINX_ENABLED"
    exit 1
fi
if [ ! -L "$GRAFANA_NGINX_ENABLED" ]; then
    echo "ERROR: Failed to create symlink at $GRAFANA_NGINX_ENABLED"
    exit 1
fi
echo "Symlinks created:"
echo "  $NODE_NGINX_ENABLED -> $NODE_NGINX_CONF"
echo "  $GRAFANA_NGINX_ENABLED -> $GRAFANA_NGINX_CONF"

# Test nginx config
nginx -t

# Start/reload nginx
systemctl enable nginx
systemctl restart nginx

# Run certbot if not already done
if [ ! -f "$CERTBOT_DONE" ]; then
    echo "Running certbot for $DOMAIN_NAME and metrics.$DOMAIN_NAME with email $DOMAIN_EMAIL"

    # Wait for nginx to be fully up
    sleep 2

    # Run certbot with persistent directories for both domains
    certbot --nginx \
        --non-interactive \
        --agree-tos \
        --email "$DOMAIN_EMAIL" \
        --domain "$DOMAIN_NAME" \
        --domain "metrics.$DOMAIN_NAME" \
        --redirect \
        --config-dir "$CERTBOT_CONFIG_DIR" \
        --work-dir "$CERTBOT_WORK_DIR" \
        --logs-dir "$CERTBOT_LOGS_DIR"

    # Mark as done
    touch "$CERTBOT_DONE"

    # Enable automatic renewal timer
    systemctl enable certbot-renew.timer
    systemctl start certbot-renew.timer

    echo "SSL certificates obtained successfully"
    echo "Automatic renewal enabled (runs twice daily)"
else
    echo "Certbot already run, skipping (remove $CERTBOT_DONE to re-run)"
fi

echo "Nginx SSL setup complete"
echo "Endpoints available at:"
echo "  https://$DOMAIN_NAME/rpc"
echo "  https://$DOMAIN_NAME/ws"
echo "  https://$DOMAIN_NAME/summit"
echo "  https://$DOMAIN_NAME/enclave"
echo "  https://metrics.$DOMAIN_NAME/ (Grafana)"
