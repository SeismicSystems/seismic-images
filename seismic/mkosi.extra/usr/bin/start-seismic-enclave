#!/bin/bash
set -euo pipefail

CONFIG_FILE="/persistent/conf/node.json"

# Extract custom args if config exists
CUSTOM_ARGS=""
RUST_LOG="debug"
if [ -f "$CONFIG_FILE" ]; then
    CUSTOM_ARGS=$(jq -r '.args.enclave // ""' "$CONFIG_FILE")
    RUST_LOG=$(jq -r '.log.enclave // ""' "$CONFIG_FILE")
fi

export RUST_LOG=$RUST_LOG

# Execute seismic-enclave-server with custom args
exec /usr/bin/seismic-enclave-server --ip 0.0.0.0 --port 7878 $CUSTOM_ARGS
