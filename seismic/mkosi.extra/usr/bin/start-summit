#!/bin/bash
set -euo pipefail

CONFIG_FILE="/persistent/conf/node.json"

# Default args as a string
DEFAULT_ARGS='run --engine-ipc-path /var/volatile/reth_engine_api.ipc --genesis-path /persistent/summit/genesis.toml --store-path /persistent/summit/db --key-store-path /persistent/summit/keys --port 18551 --rpc-port 3030 --prom-port 9090 --db-prefix quarts'

# Extract custom args if config exists
CUSTOM_ARGS=""
RUST_LOG="debug"
if [ -f "$CONFIG_FILE" ]; then
    CUSTOM_ARGS=$(jq -r '.args.summit // ""' "$CONFIG_FILE")
    RUST_LOG=$(jq -r '.log.summit // "debug"' "$CONFIG_FILE")
fi

export RUST_LOG=$RUST_LOG

# Execute summit with defaults + custom args
exec /usr/bin/summit $DEFAULT_ARGS $CUSTOM_ARGS --log-level $RUST_LOG
