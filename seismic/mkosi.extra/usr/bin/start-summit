#!/bin/bash
set -euo pipefail

CONFIG_FILE="/persistent/conf/node.json"

# Default args as a string
DEFAULT_ARGS='run --engine-ipc-path /var/volatile/reth_engine_api.ipc --genesis-path /persistent/summit/genesis.toml --store-path /persistent/summit/db --key-path /persistent/summit/keys/key.pem --port 18551 --rpc-port 3030 --prom-port 9090 --log-level info --db-prefix quarts'

# Extract custom args if config exists
CUSTOM_ARGS=""
if [ -f "$CONFIG_FILE" ]; then
    CUSTOM_ARGS=$(jq -r '.args.summit // ""' "$CONFIG_FILE")
fi

# Execute summit with defaults + custom args
exec /usr/bin/summit $DEFAULT_ARGS $CUSTOM_ARGS
