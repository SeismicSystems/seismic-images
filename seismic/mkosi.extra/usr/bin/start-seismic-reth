#!/bin/bash
set -euo pipefail

CONFIG_FILE="/persistent/conf/node.json"

# Default args as a string
DEFAULT_ARGS='node -vvv --enclave.endpoint-addr 0.0.0.0 --chain /usr/share/seismic-reth/genesis.json --full --datadir /persistent/reth --http --http.addr 0.0.0.0 --http.port 8545 --http.api eth,net,web3,trace,rpc,debug,txpool --ws --ws.addr 0.0.0.0 --ws.port 8546 --ws.api eth,net,trace,web3,rpc,debug,txpool --auth-ipc --auth-ipc.path /var/volatile/reth_engine_api.ipc --log.stdout.format json --log.file.max-files 0 --metrics 127.0.0.1:9001'

# Extract custom args if config exists
CUSTOM_ARGS=""
if [ -f "$CONFIG_FILE" ]; then
    CUSTOM_ARGS=$(jq -r '.args.reth // ""' "$CONFIG_FILE")
fi

# Execute seismic-reth with defaults + custom args
exec /usr/bin/seismic-reth $DEFAULT_ARGS $CUSTOM_ARGS
