#!/bin/bash
set -euo pipefail

CONFIG_FILE="/persistent/conf/node.json"

# Default args as a string
DEFAULT_ARGS='node -vvv --enclave.endpoint-addr 0.0.0.0 --enclave.endpoint-port 7878 --chain /usr/share/seismic-reth/genesis.json --full --datadir /persistent/reth --http --http.addr 0.0.0.0 --http.port 8545 --http.api all --http.corsdomain * --ws --ws.addr 0.0.0.0 --ws.port 8546 --ws.api all --ws.origins * --auth-ipc --auth-ipc.path /var/volatile/reth_engine_api.ipc --log.stdout.format json --log.file.max-files 0 --metrics 127.0.0.1:9001'

# Extract custom args if config exists
CUSTOM_ARGS=""
RUST_LOG="debug"
if [ -f "$CONFIG_FILE" ]; then
    CUSTOM_ARGS=$(jq -r '.args.reth // ""' "$CONFIG_FILE")
    RUST_LOG=$(jq -r '.log.reth // "debug"' "$CONFIG_FILE")
fi

export RUST_LOG=$RUST_LOG

# Execute seismic-reth with defaults + custom args
exec /usr/bin/seismic-reth $DEFAULT_ARGS $CUSTOM_ARGS
