# Seismic firewall configuration
# This script is sourced from init-firewall.sh (provided by bob-common)
# See also: bob-common/mkosi.extra/usr/bin/init-firewall.sh

# Seismic-specific ports
SSH_PORT=22
SSH_REGISTER_PORT=8080
HTTPS_PORT=443

# Well-known ports
DNS_PORT=53
HTTP_PORT=80
NTP_PORT=123

###########################################################################
# (1) ALWAYS_IN: Inbound rules that are always applied
###########################################################################

accept_dst_port $CHAIN_ALWAYS_IN tcp $SSH_PORT "SSH (dropbear)"
accept_dst_port $CHAIN_ALWAYS_IN tcp $HTTPS_PORT "HTTPS"

###########################################################################
# (2) ALWAYS_OUT: Outbound rules that are always applied
###########################################################################

accept_dst_port $CHAIN_ALWAYS_OUT udp $NTP_PORT "NTP"
accept_dst_port $CHAIN_ALWAYS_OUT udp $DNS_PORT "DNS (UDP)"
accept_dst_port $CHAIN_ALWAYS_OUT tcp $DNS_PORT "DNS (TCP)"
accept_dst_port $CHAIN_ALWAYS_OUT tcp $HTTP_PORT "HTTP"
accept_dst_port $CHAIN_ALWAYS_OUT tcp $HTTPS_PORT "HTTPS"

###########################################################################
# (3) MAINTENANCE_IN: Inbound rules for Maintenance Mode
###########################################################################

# Allow SSH key registration in maintenance mode
accept_dst_port $CHAIN_MAINTENANCE_IN tcp $SSH_REGISTER_PORT "SSH key registration"

###########################################################################
# (4) MAINTENANCE_OUT: Outbound rules for Maintenance Mode
###########################################################################

# Maintenance mode has same outbound rules as ALWAYS_OUT (defined above)

###########################################################################
# (5) PRODUCTION_IN: Inbound rules for Production Mode
###########################################################################

# Production mode closes SSH key registration port
# SSH (port 22) remains open via ALWAYS_IN

###########################################################################
# (6) PRODUCTION_OUT: Outbound rules for Production Mode
###########################################################################

# Production mode has same outbound rules as ALWAYS_OUT (defined above)
