[Unit]
Description=Seismic Enclave TDX Attestation Server
After=network.target persistent-mount.service seismic-reth.service
Requires=persistent-mount.service seismic-reth.service

[Service]
User=enclave
Group=seismic
WorkingDirectory=/persistent/enclave
Environment="RUST_BACKTRACE=full"
Environment="AS_WORK_DIR=/opt/confidential-containers/attestation-service"

# Setup TPM access
ExecStartPre=+/bin/chmod 660 /dev/tpm*
ExecStartPre=+/bin/chown root:tss /dev/tpm*

# Setup directories and permissions
ExecStartPre=+/bin/mkdir -p /persistent/enclave
ExecStartPre=+/bin/chown -R enclave:seismic /persistent/enclave
ExecStartPre=+/bin/chmod 775 /persistent/enclave
ExecStartPre=+/bin/chmod 666 /persistent/enclave/ex_keypair.json || true

ExecStartPre=+/bin/mkdir -p /opt/confidential-containers
ExecStartPre=+/bin/chown -R enclave:seismic /opt/confidential-containers
ExecStartPre=+/bin/chmod g+rwx /opt/confidential-containers
ExecStartPre=+/bin/chmod ug+s /opt/confidential-containers

ExecStart=/usr/bin/seismic-enclave-server

# Auto-restart with delay
Restart=always
RestartSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=minimal.target
